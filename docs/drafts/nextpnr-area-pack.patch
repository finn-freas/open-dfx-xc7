+void XilinxPacker::pair_luts(int min_shared)
+{
+    auto pairable = [&](const CellInfo *ci) {
+        if (ci->type != id_SLICE_LUTX || ci->cluster != ClusterId() || !ci->constr_children.empty())
+            return false;
+        if (ci->attrs.count(id_X_LUT_AS_DRAM) || ci->attrs.count(id_X_LUT_AS_SRL))
+            return false;
+        if (ci->getPort(id_A6) != nullptr || ci->getPort(id_O5) != nullptr || ci->getPort(id_O6) == nullptr)
+            return false;
+        return true;
+    };
+    auto inputs_of = [&](CellInfo *ci) {
+        std::vector<NetInfo *> nets;
+        for (IdString a : {id_A1, id_A2, id_A3, id_A4, id_A5}) {
+            NetInfo *n = ci->getPort(a);
+            if (n != nullptr && std::find(nets.begin(), nets.end(), n) == nets.end())
+                nets.push_back(n);
+        }
+        return nets;
+    };
+    const int max_fanout_scanned = 64;
+    pool<IdString> paired;
+    int pairs = 0;
+    std::vector<CellInfo *> luts;
+    for (auto &cell : ctx->cells)
+        if (pairable(cell.second.get()))
+            luts.push_back(cell.second.get());
+    for (CellInfo *a : luts) {
+        if (paired.count(a->name) || !pairable(a))
+            continue;
+        std::vector<NetInfo *> ia = inputs_of(a);
+        dict<IdString, int> shared;
+        for (NetInfo *n : ia) {
+            if (n->users.entries() > max_fanout_scanned)
+                continue;
+            for (auto &usr : n->users)
+                if (usr.cell != a && usr.cell->type == id_SLICE_LUTX)
+                    shared[usr.cell->name]++;
+        }
+        CellInfo *best = nullptr;
+        int best_shared = 0, best_union = 6;
+        for (auto &s : shared) {
+            if (s.second < min_shared || paired.count(s.first))
+                continue;
+            CellInfo *b = ctx->cells.at(s.first).get();
+            if (!pairable(b))
+                continue;
+            std::vector<NetInfo *> u = ia;
+            for (NetInfo *n : inputs_of(b))
+                if (std::find(u.begin(), u.end(), n) == u.end())
+                    u.push_back(n);
+            const int n_union = int(u.size());
+            if (n_union > 5)
+                continue;
+            const bool better = s.second > best_shared || (s.second == best_shared && n_union < best_union) ||
+                                (s.second == best_shared && n_union == best_union && best != nullptr && b->name < best->name);
+            if (better) {
+                best = b;
+                best_shared = s.second;
+                best_union = n_union;
+            }
+        }
+        if (best == nullptr)
+            continue;
+        auto drives_lone_ff = [&](CellInfo *ci) {
+            NetInfo *o = ci->getPort(id_O6);
+            return o->users.entries() == 1 && (*o->users.begin()).cell->type == id_SLICE_FFX &&
+                   (*o->users.begin()).port == id_D;
+        };
+        CellInfo *lut6 = a, *lut5 = best;
+        if (drives_lone_ff(best) && !drives_lone_ff(a))
+            std::swap(lut6, lut5);
+        lut5->renamePort(id_O6, id_O5);
+        lut5->attrs.erase(ctx->id("X_ORIG_PORT_O6"));
+        lut5->attrs[ctx->id("X_ORIG_PORT_O5")] = std::string("O");
+        lut6->cluster = lut6->name;
+        lut5->cluster = lut6->name;
+        lut6->constr_children.push_back(lut5);
+        lut5->constr_x = 0;
+        lut5->constr_y = 0;
+        lut5->constr_abs_z = false;
+        lut5->constr_z = BEL_5LUT - BEL_6LUT;
+        paired.insert(a->name);
+        paired.insert(best->name);
+        ++pairs;
+    }
+    log_info("Paired %d LUTs sharing at least %d inputs into dual-output LUT sites.\n", pairs, min_shared);
+}
