+    void place_pinned_clusters(const std::vector<CellInfo *> &pinned)
+    {
+        NEXTPNR_NAMESPACE_PREFIX pool<ClusterId> seen;
+        int carried = 0;
+        std::vector<std::pair<CellInfo *, BelId>> placement;
+        for (CellInfo *ci : pinned) {
+            const bool not_in_a_new_cluster = ci->cluster == ClusterId() || seen.count(ci->cluster);
+            if (not_in_a_new_cluster)
+                continue;
+            seen.insert(ci->cluster);
+            CellInfo *root = ctx->getClusterRootCell(ci->cluster);
+            BelId root_bel = root->bel;
+            const bool root_is_free = (root_bel == BelId());
+            if (root_is_free)
+                root_bel = root_bel_of_pinned_members(root, ci);
+            const bool cluster_fits_its_pinned_members =
+                    root_bel != BelId() && ctx->getClusterPlacement(root->cluster, root_bel, placement);
+            if (!cluster_fits_its_pinned_members)
+                log_error("the cluster of '%s' (root '%s') has no placement that keeps '%s' on its bel '%s'\n",
+                          ctx->nameOf(ci), ctx->nameOf(root), ctx->nameOf(ci), ctx->nameOfBel(ci->bel));
+            for (auto &pb : placement) {
+                const bool member_already_has_a_bel = (pb.first->bel != BelId());
+                if (member_already_has_a_bel)
+                    continue;
+                CellInfo *holder = ctx->getBoundBelCell(pb.second);
+                const bool wanted_bel_is_taken = (holder != nullptr);
+                if (wanted_bel_is_taken)
+                    log_error("cluster member '%s' of pinned '%s' needs bel '%s', which '%s' holds\n",
+                              ctx->nameOf(pb.first), ctx->nameOf(ci), ctx->nameOfBel(pb.second),
+                              ctx->nameOf(holder));
+                ctx->bindBel(pb.second, pb.first, STRENGTH_USER);
+                carried++;
+            }
+        }
+        if (carried)
+            log_info("Placed %d cluster member(s) with their pinned cluster.\n", carried);
+    }
