From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] xilinx: take IOSTANDARD/DRIVE/SLEW/DIFF_TERM from the IO
 buffer

pack_io copied only the top-level port's attributes to the PAD cell, so
an IOBUF/OBUF/IBUFDS parameter such as DRIVE(8) was dropped.  The
buffer's parameters now reach each of its pads unless the port has the
same property from the XDC, which wins as in Vivado.
---
 himbaechel/uarch/xilinx/pack_io.cc | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/himbaechel/uarch/xilinx/pack_io.cc b/himbaechel/uarch/xilinx/pack_io.cc
index 5e00f4e7..59282931 100644
--- a/himbaechel/uarch/xilinx/pack_io.cc
+++ b/himbaechel/uarch/xilinx/pack_io.cc
@@ -457,6 +457,27 @@ void XC7Packer::pack_io()
             log_error("FIXME: unconstrained IO not supported (pad %s)\n", ctx->nameOf(pad));
         }
     }
+
+
+
+
+
+    for (auto &iob : pad_and_buf) {
+        CellInfo *pad = iob.first;
+        CellInfo *buf = iob.second.cell;
+        for (auto &param : buf->params) {
+            const IdString key = param.first;
+            const bool is_io_property =
+                    key.in(id_IOSTANDARD, id_DRIVE, id_SLEW) || key.str(ctx) == "DIFF_TERM";
+            if (!is_io_property || pad->attrs.count(key))
+                continue;
+            const bool is_default_standard =
+                    key == id_IOSTANDARD && param.second.is_string && param.second.as_string() == "DEFAULT";
+            if (is_default_standard)
+                continue;
+            pad->attrs[key] = param.second;
+        }
+    }
     // Decompose macro IO primitives to smaller primitives that map logically to the actual IO Bels
     for (auto &iob : pad_and_buf) {
         auto pad_cell = iob.first;
