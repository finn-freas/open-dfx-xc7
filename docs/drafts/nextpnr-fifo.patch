+void XC7Packer::pack_fifos()
+{
+    std::vector<CellInfo *> fifos;
+    for (auto &cell : ctx->cells)
+        if (cell.second->type.in(id_FIFO18E1, id_FIFO36E1))
+            fifos.push_back(cell.second.get());
+    if (fifos.empty())
+        return;
+    log_info("Packing FIFOs..\n");
+
+
+    dict<IdString, XFormRule> rules[2];
+    for (int full_width = 0; full_width < 2; full_width++) {
+        const char *lo = full_width ? "DIADI%d" : "DIBDI%d", *hi = full_width ? "DIBDI%d" : "DIADI%d";
+        const char *plo = full_width ? "DIPADIP%d" : "DIPBDIP%d", *phi = full_width ? "DIPBDIP%d" : "DIPADIP%d";
+        XFormRule &f18 = rules[full_width][id_FIFO18E1];
+        f18.new_type = id_FIFO18E1_FIFO18E1;
+        for (int i = 0; i < 32; i++)
+            f18.port_xform[ctx->idf("DI[%d]", i)] = ctx->idf(i < 16 ? lo : hi, i % 16);
+        for (int i = 0; i < 4; i++)
+            f18.port_xform[ctx->idf("DIP[%d]", i)] = ctx->idf(i < 2 ? plo : phi, i % 2);
+
+        XFormRule &f36 = rules[full_width][id_FIFO36E1];
+        f36.new_type = id_RAMBFIFO36E1_RAMBFIFO36E1;
+        for (int i = 0; i < 64; i++) {
+            f36.port_xform[ctx->idf("DI[%d]", i)] = ctx->idf(i < 32 ? lo : hi, i % 32);
+            f36.port_xform[ctx->idf("DO[%d]", i)] = ctx->idf(i < 32 ? "DOADO%d" : "DOBDO%d", i % 32);
+        }
+        for (int i = 0; i < 8; i++) {
+            f36.port_xform[ctx->idf("DIP[%d]", i)] = ctx->idf(i < 4 ? plo : phi, i % 4);
+            f36.port_xform[ctx->idf("DOP[%d]", i)] = ctx->idf(i < 4 ? "DOPADOP%d" : "DOPBDOP%d", i % 4);
+        }
+        f36.port_multixform[id_RDCLK] = {ctx->id("CLKARDCLKL"), ctx->id("CLKARDCLKU")};
+        f36.port_multixform[id_WRCLK] = {ctx->id("CLKBWRCLKL"), ctx->id("CLKBWRCLKU")};
+        f36.port_multixform[id_RSTREG] = {ctx->id("RSTREGARSTREGL"), ctx->id("RSTREGARSTREGU")};
+        f36.port_multixform[ctx->id("REGCE")] = {ctx->id("REGCEAREGCEL"), ctx->id("REGCEAREGCEU")};
+        f36.port_multixform[ctx->id("RDRCLK")] = {ctx->id("REGCLKARDRCLKL"), ctx->id("REGCLKARDRCLKU")};
+        f36.port_xform[id_RDEN] = ctx->id("ENARDENL");
+        f36.port_xform[id_WREN] = ctx->id("ENBWRENL");
+        f36.port_xform[id_RST] = ctx->id("RSTRAMARSTRAMLRST");
+    }
+
+    for (auto ci : fifos) {
+        const bool uses_ecc = str_or_default(ci->params, ctx->id("EN_ECC_READ"), "FALSE") == "TRUE" ||
+                              str_or_default(ci->params, ctx->id("EN_ECC_WRITE"), "FALSE") == "TRUE";
+        if (uses_ecc)
+            log_error("%s: FIFO36E1 with EN_ECC_READ or EN_ECC_WRITE is not supported\n", ctx->nameOf(ci));
+
+
+        NetInfo *rdclk = ci->getPort(id_RDCLK);
+        const bool output_registered = int_or_default(ci->params, ctx->id("DO_REG"), 1) == 1;
+        if (output_registered && rdclk != nullptr) {
+            ci->addInput(ctx->id("RDRCLK"));
+            ci->connectPort(ctx->id("RDRCLK"), rdclk);
+        }
+        const int width = int_or_default(ci->params, ctx->id("DATA_WIDTH"), 4);
+        const bool full_width = width == (ci->type == id_FIFO36E1 ? 72 : 36);
+        xform_cell(rules[full_width], ci);
+    }
+}
