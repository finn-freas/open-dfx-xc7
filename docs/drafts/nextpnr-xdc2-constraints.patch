+void XilinxImpl::check_clock_placement()
+{
+    auto reaches_ccio = [&](BelId inbuf) {
+        WireId start = ctx->getBelPinWire(inbuf, id_OUT);
+        if (start == WireId())
+            return false;
+        std::vector<WireId> frontier = {start};
+        pool<WireId> seen = {start};
+        for (int depth = 0; depth < 12 && !frontier.empty() && seen.size() < 4096; depth++) {
+            std::vector<WireId> next;
+            for (WireId w : frontier)
+                for (PipId pip : ctx->getPipsDownhill(w)) {
+                    WireId dst = ctx->getPipDstWire(pip);
+                    if (!seen.insert(dst).second)
+                        continue;
+                    const std::string name = ctx->getWireName(dst)[1].str(ctx);
+                    const bool is_clock_entry = boost::contains(name, "CCIO") || boost::contains(name, "I2GCLK") ||
+                                                boost::contains(name, "I2IOCLK");
+                    auto onward = ctx->getPipsDownhill(dst);
+                    if (is_clock_entry && onward.begin() != onward.end())
+                        return true;
+                    next.push_back(dst);
+                }
+            frontier.swap(next);
+        }
+        return false;
+    };
+    int y_bottom = -1, y_top = -1;
+    for (BelId bel : ctx->getBels()) {
+        if (ctx->getBelType(bel) != id_BUFGCTRL)
+            continue;
+        SiteIndex si = get_bel_site(bel);
+        const auto &sites = tile_extra_data(si.tile)->sites;
+        if (si.site < 0 || si.site >= int32_t(sites.ssize()))
+            continue;
+        const std::string site = get_site_name(si).str(ctx);
+        if (site == "BUFGCTRL_X0Y15")
+            y_bottom = ctx->getBelLocation(bel).y;
+        else if (site == "BUFGCTRL_X0Y16")
+            y_top = ctx->getBelLocation(bel).y;
+    }
+    if (y_bottom < 0 || y_top < 0)
+        return;
+    const double middle = (y_bottom + y_top) / 2.0;
+    const bool top_is_below = y_top > y_bottom;
+    auto is_top = [&](int y) { return top_is_below ? y > middle : y < middle; };
+    int failures = 0;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        if (ci->type != id_BUFGCTRL || ci->bel == BelId())
+            continue;
+        for (IdString pin : {id_I0, id_I1}) {
+            NetInfo *in = ci->getPort(pin);
+            if (in == nullptr || in->driver.cell == nullptr)
+                continue;
+            CellInfo *buf = in->driver.cell;
+            const bool is_input_buffer = boost::contains(buf->type.str(ctx), "INBUF");
+            if (!is_input_buffer || buf->bel == BelId())
+                continue;
+            CellInfo *pad = nullptr;
+            for (auto &port : buf->ports)
+                if (port.second.net != nullptr)
+                    for (auto &usr : port.second.net->users)
+                        if (usr.cell->type == id_PAD)
+                            pad = usr.cell;
+            if (pad == nullptr || pad->bel == BelId())
+                continue;
+            const PadInfoPOD *pin_info = ctx->get_bel_package_pin(pad->bel);
+            if (pin_info == nullptr)
+                continue;
+            const std::string site_bel = ctx->getBelName(pad->bel)[1].str(ctx);
+            const bool is_clock_capable = reaches_ccio(buf->bel);
+            const bool is_n_side = boost::contains(site_bel, "33S.") || boost::contains(site_bel, "18S.");
+            const std::string function = site_bel;
+            const bool pad_top = is_top(ctx->getBelLocation(pad->bel).y);
+            const bool bufg_top = is_top(ctx->getBelLocation(ci->bel).y);
+            std::string why;
+            if (!is_clock_capable)
+                why = "the pin is not clock capable (" + function + ")";
+            else if (is_n_side)
+                why = "a single-ended clock is on the N side of its pair (" + function + ")";
+            else if (pad_top != bufg_top)
+                why = stringf("the BUFGCTRL is in the %s half of the device and the pin in the %s half",
+                              bufg_top ? "top" : "bottom", pad_top ? "top" : "bottom");
+            if (why.empty())
+                continue;
+            const bool demoted = str_or_default(in->attrs, ctx->id("CLOCK_DEDICATED_ROUTE"), "") == "FALSE";
+            std::string msg = stringf("clock placement (Vivado Place 30-574, rule_gclkio_bufg): port '%s' "
+                                      "(%s) drives BUFGCTRL '%s' at %s through '%s', and %s; the clock cannot use "
+                                      "the dedicated route.  CLOCK_DEDICATED_ROUTE FALSE on net '%s' accepts this\n",
+                                      ctx->nameOf(pad), IdString(pin_info->package_pin).c_str(ctx), ctx->nameOf(ci),
+                                      ctx->nameOfBel(ci->bel), ctx->nameOf(buf), why.c_str(), ctx->nameOf(in));
+            if (demoted)
+                log_warning("%s", msg.c_str());
+            else {
+                log_nonfatal_error("%s", msg.c_str());
+                failures++;
+            }
+        }
+    }
+    if (failures > 0 && !ctx->force)
+        log_error("%d clock placement rule violation(s); use --force to continue anyway\n", failures);
+}
