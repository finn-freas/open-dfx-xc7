+            Region *pb_region = ctx->region.at(pb->region).get();
+            int added = 0;
+            for (int cursor = 2; cursor < int(arguments.size()); cursor++) {
+                const std::string &sel = arguments.at(cursor);
+                const bool is_option = !sel.empty() && sel.front() == '-';
+                if (is_option) {
