+static void xilinx_dsp_merge_input_ffs(Module *module)
+{
+	SigMap sigmap(module);
+	FfInitVals initvals(&sigmap, module);
+	dict<SigBit, Cell*> q2ff;
+	auto index_ff = [&](Cell *cell) {
+		if (cell && cell->type.in(ID($dff), ID($dffe), ID($sdff), ID($sdffe), ID($sdffce)))
+			for (auto bit : sigmap(cell->getPort(ID::Q)))
+				q2ff[bit] = cell;
+	};
+	for (auto cell : module->cells())
+		index_ff(cell);
+
+	std::vector<Cell*> dsps;
+	for (auto cell : module->selected_cells())
+		if (cell->type == ID(DSP48E1))
+			dsps.push_back(cell);
+
+	for (auto dsp : dsps)
+	for (auto port : {ID::A, ID::B}) {
+		SigSpec sig = dsp_unextend(sigmap(dsp->getPort(port)));
+		pool<SigBit> bits;
+		std::vector<Cell*> ffs;
+		bool ok = !sig.empty();
+		for (auto bit : sig) {
+			if (!bit.wire || bits.count(bit) || !q2ff.count(bit)) {
+				ok = false;
+				break;
+			}
+			bits.insert(bit);
+			Cell *ff = q2ff.at(bit);
+			if (std::find(ffs.begin(), ffs.end(), ff) == ffs.end())
+				ffs.push_back(ff);
+		}
+		if (!ok || GetSize(ffs) < 2)
+			continue;
+
+		std::vector<FfData> ffd;
+		for (auto ff : ffs)
+			ffd.emplace_back(&initvals, ff);
+		const FfData &ff0 = ffd.front();
+		bool same_srst = true;
+		for (auto &ff : ffd) {
+			if (ff.is_fine || !ff.has_clk || !ff.pol_clk || ff.has_arst || ff.has_aload || ff.has_sr || ff.sig_clk != ff0.sig_clk)
+				ok = false;
+			if (ff.has_srst != ff0.has_srst || (ff.has_srst && (ff.sig_srst != ff0.sig_srst || ff.pol_srst != ff0.pol_srst || ff.ce_over_srst != ff0.ce_over_srst)))
+				same_srst = false;
+			for (int i = 0; i < ff.width; i++)
+				if (bits.count(sigmap(ff.sig_q[i])) && ff.val_init[i] != State::Sx && ff.val_init[i] != State::S0)
+					ok = false;
+		}
+
+
+
+		auto keeps_ce = [&](const FfData &ff) {
+			return ff.has_ce && (same_srst || !ff.has_srst || ff.ce_over_srst);
+		};
+		for (auto &ff : ffd)
+			if (keeps_ce(ff) != keeps_ce(ff0) || (keeps_ce(ff) && (ff.sig_ce != ff0.sig_ce || ff.pol_ce != ff0.pol_ce)))
+				ok = false;
+		if (!ok)
+			continue;
+
+		std::vector<FfData> parts;
+		dict<SigBit, std::pair<int, int>> where;
+		for (auto &ff : ffd) {
+			std::vector<int> in, out;
+			for (int i = 0; i < ff.width; i++)
+				(bits.count(sigmap(ff.sig_q[i])) ? in : out).push_back(i);
+			FfData part = ff.slice(in);
+			FfData rest = ff.slice(out);
+			ff.remove();
+			if (!out.empty())
+				index_ff(rest.emit());
+			if (!same_srst)
+				part.unmap_srst();
+			for (int i = 0; i < part.width; i++)
+				where[sigmap(part.sig_q[i])] = std::make_pair(GetSize(parts), i);
+			parts.push_back(part);
+		}
+
+		FfData merged = parts.front();
+		SigSpec d, q;
+		std::vector<State> init, srst;
+		for (auto bit : sig) {
+			auto &w = where.at(bit);
+			const FfData &part = parts[w.first];
+			d.append(part.sig_d[w.second]);
+			q.append(part.sig_q[w.second]);
+			init.push_back(part.val_init[w.second]);
+			if (merged.has_srst)
+				srst.push_back(part.val_srst[w.second]);
+		}
+		merged.sig_d = d;
+		merged.sig_q = q;
+		merged.width = GetSize(q);
+		merged.val_init = Const(init);
+		if (merged.has_srst)
+			merged.val_srst = Const(srst);
+		Cell *cell = merged.emit();
+		index_ff(cell);
+		log("  merged %d registers driving %s.%s into %s\n", GetSize(ffs), dsp, port == ID::A ? "A" : "B", cell);
+	}
+}
+
