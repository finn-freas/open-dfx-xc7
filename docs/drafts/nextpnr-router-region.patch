+    template <typename Tf> bool any_hop_of_arc(NetInfo *net, store_index<PortRef> usr, size_t phys_pin, Tf visit)
+    {
+        auto &nd = nets.at(net->udata);
+        auto &ad = nd.arcs.at(usr.idx()).at(phys_pin);
+        WireId cursor = ad.sink_wire;
+        while (cursor != nd.src_wire && nd.wires.count(cursor)) {
+            if (net->constant_value != IdString() && ctx->getWireConstantValue(cursor) == net->constant_value)
+                break;
+            PipId pip = nd.wires.at(cursor).first;
+            if (pip == PipId())
+                break;
+            if (visit(pip, cursor))
+                return true;
+            cursor = ctx->getPipSrcWire(pip);
+        }
+        return false;
+    }
+
+
+    bool route_to_wire_is_in_region(const PerNetData &nd, WireId wire, int r)
+    {
+        WireId cursor = wire;
+        while (cursor != nd.src_wire) {
+            auto fnd = nd.wires.find(cursor);
+            if (fnd == nd.wires.end() || fnd->second.first == PipId())
+                break;
+            PipId pip = fnd->second.first;
+            if (!hop_is_in_region(r, pip, wire_data(cursor)))
+                return false;
+            cursor = ctx->getPipSrcWire(pip);
+        }
+        return true;
+    }
