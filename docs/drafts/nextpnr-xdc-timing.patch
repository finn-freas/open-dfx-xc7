+void XilinxImpl::apply_xdc_clock_exceptions()
+{
+    if (xdc_clock_exceptions.empty())
+        return;
+    dict<IdString, IdString> clock_primary;
+    for (auto &net : ctx->nets) {
+        const ClockConstraint *cc = net.second->clkconstr.get();
+        if (cc != nullptr && cc->name != IdString())
+            clock_primary[cc->name] = cc->master;
+    }
+    auto resolve = [&](const std::vector<XdcClockPattern> &patterns, int lineno) {
+        pool<IdString> clocks;
+        for (const auto &pat : patterns) {
+            std::string dotted = pat.pattern;
+            std::replace(dotted.begin(), dotted.end(), '/', '.');
+            bool matched = false;
+            for (auto &clk : clock_primary) {
+                const std::string &name = clk.first.str(ctx);
+                bool hit = glob_match(name, pat.pattern) || glob_match(name, dotted);
+                const bool is_generated = clk.second != IdString();
+                if (!hit && pat.include_generated && is_generated)
+                    hit = glob_match(clk.second.str(ctx), pat.pattern);
+                if (hit) {
+                    clocks.insert(clk.first);
+                    matched = true;
+                }
+            }
+            if (!matched)
+                log_warning("clock '%s' (on line %d) is none of this design's clocks, so the exception is NOT "
+                            "applied to it\n",
+                            pat.pattern.c_str(), lineno);
+        }
+        return clocks;
+    };
+    pool<IdString> all_clocks;
+    for (auto &clk : clock_primary)
+        all_clocks.insert(clk.first);
+    dict<IdString, pool<IdString>> false_path_to;
+    for (const auto &ex : xdc_clock_exceptions) {
+        std::vector<pool<IdString>> sides;
+        if (ex.is_groups) {
+            for (const auto &group : ex.groups)
+                sides.push_back(resolve(group, ex.lineno));
+            if (sides.size() == 1) {
+                pool<IdString> others;
+                for (IdString clk : all_clocks)
+                    if (!sides.front().count(clk))
+                        others.insert(clk);
+                sides.push_back(others);
+            }
+        } else {
+            sides.push_back(ex.from.empty() ? all_clocks : resolve(ex.from, ex.lineno));
+            sides.push_back(ex.to.empty() ? all_clocks : resolve(ex.to, ex.lineno));
+        }
+        for (int i = 0; i < int(sides.size()); i++)
+            for (int j = 0; j < int(sides.size()); j++) {
+                const bool is_a_direction = ex.is_groups ? i != j : (i == 0 && j == 1);
+                if (!is_a_direction)
+                    continue;
+                for (IdString launch : sides.at(i))
+                    for (IdString capture : sides.at(j))
+                        if (launch != capture)
+                            false_path_to[launch].insert(capture);
+            }
+    }
+    for (auto &net : ctx->nets) {
+        ClockConstraint *cc = net.second->clkconstr.get();
+        if (cc != nullptr && false_path_to.count(cc->name))
+            for (IdString capture : false_path_to.at(cc->name))
+                cc->false_path_to.insert(capture);
+    }
+    for (auto &entry : false_path_to)
+        for (IdString capture : entry.second)
+            log_info("    no path from clock '%s' to clock '%s' is timed (set_false_path or set_clock_groups)\n",
+                     entry.first.c_str(ctx), capture.c_str(ctx));
