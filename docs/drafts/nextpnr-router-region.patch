+    bool arc_route_breaks_region(NetInfo *net, store_index<PortRef> usr, size_t phys_pin)
+    {
+        if (route_regions.empty())
+            return false;
+        auto &ad = nets.at(net->udata).arcs.at(usr.idx()).at(phys_pin);
+        const bool arc_has_region_rules = ad.contain_region != -1 || cfg.region_keep_out;
+        if (!arc_has_region_rules)
+            return false;
+        return any_hop_of_arc(net, usr, phys_pin,
+                              [&](PipId pip, WireId dst) { return !hop_allowed_for_arc(ad, pip, wire_data(dst)); });
+    }
+
+
+
+    bool arc_route_is_locked(NetInfo *net, store_index<PortRef> usr, size_t phys_pin)
+    {
+        return any_hop_of_arc(net, usr, phys_pin, [&](PipId, WireId dst) {
+            auto fnd = net->wires.find(dst);
+            return fnd != net->wires.end() && fnd->second.strength > STRENGTH_STRONG;
+        });
+    }
