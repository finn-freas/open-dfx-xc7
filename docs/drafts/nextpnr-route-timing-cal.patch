+import re
 
 CELL_CAL = {}
+ROUTE_CAL = {}
+
+def route_wire_class(wire_name):
+    for cls, pat in ROUTE_CAL.get("classes", []):
+        if re.match(pat, wire_name):
+            return cls
+    return None
+
+def route_pip_timing(pip, dst_name):
+    base = timing_pip_classs(pip)
+    cls = route_wire_class(dst_name) if ROUTE_CAL else None
+    add = ROUTE_CAL.get("pip_add", {}).get(cls) if cls else None
+    if not add:
+        return base, int(pip.min_delay()*1000), int(pip.max_delay()*1000)
+    return f"{base}_{cls}", max(0, int(pip.min_delay()*1000) + add[0]), max(0, int(pip.max_delay()*1000) + add[1])
 
