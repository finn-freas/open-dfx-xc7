From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] clkbufmap: keep clock-buffer inputs on the unbuffered clock

When a net that gets a new buffer also drives the input of a clock
buffer (a cell type with a clkbuf_driver output, such as BUFIO or BUFR),
that input is connected back to the unbuffered net, so a BUFG is no
longer put in front of a BUFIO/BUFR input.
---
 passes/techmap/clkbufmap.cc | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/passes/techmap/clkbufmap.cc b/passes/techmap/clkbufmap.cc
index bcf05dddd..ddf169f29 100644
--- a/passes/techmap/clkbufmap.cc
+++ b/passes/techmap/clkbufmap.cc
@@ -62,6 +62,11 @@ struct ClkbufmapPass : public Pass {
 		log("        to the clock buffer, if any).\n");
 		log("\n");
 		log("At least one of -buf or -inpad should be specified.\n");
+		log("\n");
+		log("Inputs of existing clock buffer cells (cells with a 'clkbuf_driver' output)\n");
+		log("stay connected to the unbuffered net when a buffer is inserted, so that a\n");
+		log("clock that feeds both such a cell and other clock sinks is not routed\n");
+		log("through the inserted buffer.\n");
 	}
 
 	void module_queue(Design *design, Module *module, std::vector<Module *> &modules_sorted, pool<Module *> &modules_processed) {
@@ -116,6 +121,7 @@ struct ClkbufmapPass : public Pass {
 		// Cell type, port name, bit index.
 		pool<pair<IdString, pair<IdString, int>>> sink_ports;
 		pool<pair<IdString, pair<IdString, int>>> buf_ports;
+		pool<IdString> buf_cell_types;
 		dict<pair<IdString, pair<IdString, int>>, pair<IdString, int>> inv_ports_out;
 		dict<pair<IdString, pair<IdString, int>>, pair<IdString, int>> inv_ports_in;
 
@@ -147,9 +153,11 @@ struct ClkbufmapPass : public Pass {
 			if (module->get_blackbox_attribute()) {
 				for (auto port : module->ports) {
 					auto wire = module->wire(port);
-					if (wire->get_bool_attribute(ID::clkbuf_driver))
+					if (wire->get_bool_attribute(ID::clkbuf_driver)) {
+						buf_cell_types.insert(module->name);
 						for (int i = 0; i < GetSize(wire); i++)
 							buf_ports.insert(make_pair(module->name, make_pair(wire->name, i)));
+					}
 					if (wire->get_bool_attribute(ID::clkbuf_sink))
 						for (int i = 0; i < GetSize(wire); i++)
 							sink_ports.insert(make_pair(module->name, make_pair(wire->name, i)));
@@ -170,6 +178,8 @@ struct ClkbufmapPass : public Pass {
 			SigMap sigmap(module);
 			// bit -> (buffer, buffer's input)
 			dict<SigBit, pair<Cell *, Wire *>> buffered_bits;
+
+			dict<SigBit, Wire *> unbuffered_bits;
 
 			// First, collect nets that could use a clock buffer.
 			for (auto cell : module->cells())
@@ -269,6 +279,7 @@ struct ClkbufmapPass : public Pass {
 							iwire = module->addWire(NEW_ID);
 							cell->setPort(buf_portname_ref, mapped_wire_bit);
 							cell->setPort(buf_portname2_ref, iwire);
+							unbuffered_bits[mapped_wire_bit] = iwire;
 						}
 						if (is_input) {
 							log("Inserting %s on %s.%s[%d].\n", inpad_celltype, module, wire, i);
@@ -349,6 +360,30 @@ struct ClkbufmapPass : public Pass {
 					cell->setPort(port.first, sig);
 			}
 
+
+			for (auto cell : module->cells()) {
+				if (!buf_cell_types.count(cell->type))
+					continue;
+				for (auto port : cell->connections()) {
+					if (!cell->input(port.first))
+						continue;
+					SigSpec sig = port.second;
+					bool newsig = false;
+					for (int i = 0; i < GetSize(sig); i++) {
+						if (sink_ports.count(make_pair(cell->type, make_pair(port.first, i))))
+							continue;
+						const auto it = unbuffered_bits.find(sigmap(sig[i]));
+						if (it == unbuffered_bits.end())
+							continue;
+						log("Connecting %s.%s.%s to the unbuffered clock.\n", module, cell, PooledName(design, port.first).unescape());
+						sig[i] = it->second;
+						newsig = true;
+					}
+					if (newsig)
+						cell->setPort(port.first, sig);
+				}
+			}
+
 			// This has to be done last, to avoid upsetting sigmap before the port reconnections.
 			for (auto &it : input_queue) {
 				Wire *wire = it.first;
