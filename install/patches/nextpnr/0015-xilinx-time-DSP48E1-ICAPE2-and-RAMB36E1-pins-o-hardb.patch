diff --git a/himbaechel/uarch/xilinx/gen/hardblock_timing.py b/himbaechel/uarch/xilinx/gen/hardblock_timing.py
new file mode 100644
index 00000000..87f472e1
--- /dev/null
+++ b/himbaechel/uarch/xilinx/gen/hardblock_timing.py
@@ -0,0 +1,77 @@
+"""
+Writes hardblock_timing.inc: the DSP48E1 and ICAPE2 timing of the prjxray-db
+SDF files as a C++ table for hardblock_timing.cc.
+
+The DSP SDF is conditional: each CELLTYPE names the parameter values under
+which its arcs hold (DSP48E1_AREG_1_MREG_0_..., an empty condition for ICAP),
+and the arcs of every CELLTYPE whose condition a cell meets apply together.
+"""
+import argparse
+from os import path
+
+import parse_sdf
+
+DSP_PARAMS = ["ACASCREG", "ADREG", "ALUMODEREG", "AREG", "A_INPUT", "BCASCREG", "BREG", "B_INPUT", "CARRYINREG",
+              "CARRYINSELREG", "CREG", "DREG", "INMODEREG", "MREG", "OPMODEREG", "PREG", "USE_DPORT", "USE_MULT",
+              "USE_PATTERN_DETECT"]
+
+
+def split_condition(celltype, prefix):
+    rest = celltype[len(prefix):].lstrip("_")
+    conds = []
+    while rest:
+        name = max((p for p in DSP_PARAMS if rest.startswith(p + "_")), key=len, default=None)
+        assert name is not None, f"cannot parse {celltype} at {rest}"
+        rest = rest[len(name) + 1:]
+        value = rest.split("_")[0]
+        if name == "USE_PATTERN_DETECT" and rest.startswith("NO_PATDET"):
+            value = "NO_PATDET"
+        rest = rest[len(value):].lstrip("_")
+        conds.append((name, value))
+    return conds
+
+
+def ps(v):
+    return int(round(v * 1000))
+
+
+def arcs_of(cell):
+    out = []
+    for e in cell.entries:
+        if isinstance(e, parse_sdf.IOPath):
+            lo = min(e.rising.minv, e.falling.minv)
+            hi = max(e.rising.maxv, e.falling.maxv)
+            out.append(("IOPATH", e.from_pin, e.to_pin, ps(lo), ps(hi)))
+        elif isinstance(e, parse_sdf.SetupHoldCheck):
+            out.append(("SETUP", e.pin, e.clock, ps(e.setup.minv), ps(e.setup.maxv)))
+            out.append(("HOLD", e.pin, e.clock, ps(e.hold.minv), ps(e.hold.maxv)))
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--xray", required=True, help="prjxray-db family directory, e.g. .../artix7")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    rows = []
+    dsp = parse_sdf.parse_sdf_file(path.join(a.xray, "timings", "DSP_L.sdf"))
+    for (celltype, _), cell in sorted(dsp.cells.items()):
+        conds = split_condition(celltype, "DSP48E1")
+        cond = ",".join(f"{k}={v}" for k, v in conds)
+        for kind, frm, to, lo, hi in arcs_of(cell):
+            rows.append(("DSP48E1_DSP48E1", cond, kind, frm, to, lo, hi))
+    cfg = parse_sdf.parse_sdf_file(path.join(a.xray, "timings", "CFG_CENTER_MID.sdf"))
+    for (celltype, _), cell in sorted(cfg.cells.items()):
+        if celltype != "ICAP":
+            continue
+        for kind, frm, to, lo, hi in arcs_of(cell):
+            rows.append(("ICAP_ICAP", "", kind, frm, to, lo, hi))
+    with open(a.out, "w") as f:
+        f.write("// Generated by gen/hardblock_timing.py from the prjxray-db SDF files (DSP_L.sdf, CFG_CENTER_MID.sdf).\n")
+        for r in rows:
+            f.write('{"%s", "%s", HardblockArc::%s, "%s", "%s", %d, %d},\n' % r)
+    print(f"{len(rows)} arcs")
+
+
+if __name__ == "__main__":
+    main()
