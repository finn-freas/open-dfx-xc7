+void XC7Packer::pack_iob_registers()
+{
+    auto is_true = [](const CellInfo *ci, IdString key) {
+        auto found = ci->attrs.find(key);
+        if (found == ci->attrs.end())
+            return false;
+        if (!found->second.is_string)
+            return found->second.as_bool();
+        std::string v = found->second.as_string();
+        std::transform(v.begin(), v.end(), v.begin(), ::toupper);
+        return v == "TRUE" || v == "1";
+    };
+    const pool<IdString> registers = {id_FDRE, id_FDSE, id_FDCE, id_FDPE};
+    auto is_inbuf = [&](const CellInfo *ci) {
+        return ci != nullptr &&
+               (boost::contains(ci->type.str(ctx), "INBUF_EN") || boost::contains(ci->type.str(ctx), "INBUF_DCIEN"));
+    };
+    auto is_outbuf = [&](const CellInfo *ci) {
+        return ci != nullptr &&
+               ci->type.in(id_IOB33_OUTBUF, id_IOB33M_OUTBUF, id_IOB18_OUTBUF_DCIEN, id_IOB18M_OUTBUF_DCIEN);
+    };
+
+    auto pad_of = [&](const CellInfo *buf) -> CellInfo * {
+        for (auto &port : buf->ports) {
+            const NetInfo *ni = port.second.net;
+            if (ni == nullptr)
+                continue;
+            for (auto &usr : ni->users)
+                if (usr.cell->type == id_PAD)
+                    return usr.cell;
+            if (ni->driver.cell != nullptr && ni->driver.cell->type == id_PAD)
+                return ni->driver.cell;
+        }
+        return nullptr;
+    };
+    pool<IdString> packed_pads;
+    int inputs = 0, outputs = 0;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        if (!registers.count(ci->type))
+            continue;
+        NetInfo *d = ci->getPort(id_D), *q = ci->getPort(id_Q);
+        CellInfo *inbuf = (d != nullptr && d->users.entries() == 1 && is_inbuf(d->driver.cell)) ? d->driver.cell
+                                                                                                 : nullptr;
+        CellInfo *outbuf = nullptr;
+        if (q != nullptr && q->users.entries() == 1) {
+            const PortRef &usr = *q->users.begin();
+            if (is_outbuf(usr.cell) && usr.port == id_IN)
+                outbuf = usr.cell;
+        }
+        CellInfo *in_pad = inbuf != nullptr ? pad_of(inbuf) : nullptr;
+        CellInfo *out_pad = outbuf != nullptr ? pad_of(outbuf) : nullptr;
+        const bool asked = is_true(ci, id_IOB) || (in_pad != nullptr && is_true(in_pad, id_IOB)) ||
+                           (out_pad != nullptr && is_true(out_pad, id_IOB));
+        if (!asked)
+            continue;
+        const bool has_inverted_reset = bool_or_default(ci->params, id_IS_R_INVERTED, false) ||
+                                        bool_or_default(ci->params, id_IS_S_INVERTED, false) ||
+                                        bool_or_default(ci->params, id_IS_CLR_INVERTED, false) ||
+                                        bool_or_default(ci->params, id_IS_PRE_INVERTED, false);
+        if (has_inverted_reset || (in_pad == nullptr && out_pad == nullptr)) {
+            log_warning("IOB TRUE: register '%s' stays in a slice: %s\n", ctx->nameOf(ci),
+                        has_inverted_reset ? "its set/reset is inverted"
+                                           : "its D does not come from an input buffer alone and its Q does not "
+                                             "drive an output buffer alone");
+            continue;
+        }
+        const bool is_sync = ci->type.in(id_FDRE, id_FDSE);
+        const bool is_set = ci->type.in(id_FDSE, id_FDPE);
+        IdString sr_port = ci->type == id_FDRE   ? id_R
+                           : ci->type == id_FDSE ? id_S
+                           : ci->type == id_FDCE ? id_CLR
+                                                 : id_PRE;
+        int init = int_or_default(ci->params, id_INIT, 0);
+        ci->params.erase(id_INIT);
+        if (ci->ports.count(sr_port))
+            ci->renamePort(sr_port, is_set ? id_S : id_R);
+        ci->params[id_SRTYPE] = std::string(is_sync ? "SYNC" : "ASYNC");
+        ci->attrs[ctx->id("X_IOB_SDR")] = std::string("1");
+        if (in_pad != nullptr) {
+            ci->type = id_IDDR;
+            ci->renamePort(id_Q, id_Q1);
+            ci->params[id_INIT_Q1] = Property(init, 1);
+            ci->params[id_INIT_Q2] = Property(1, 1);
+            ci->params[id_DDR_CLK_EDGE] = std::string("OPPOSITE_EDGE");
+            packed_pads.insert(in_pad->name);
+            if (out_pad != nullptr)
+                packed_pads.insert(out_pad->name);
+            log_info("    IOB TRUE: register '%s' in the input logic of port '%s'\n", ctx->nameOf(ci),
+                     ctx->nameOf(in_pad));
+            inputs++;
+        } else {
+            ci->type = id_ODDR;
+            ci->renamePort(id_D, id_D1);
+            ci->addInput(id_D2);
+            ci->connectPort(id_D2, ci->getPort(id_D1));
+            ci->params[id_INIT] = Property(init, 1);
+            ci->params[id_DDR_CLK_EDGE] = std::string("SAME_EDGE");
+            packed_pads.insert(out_pad->name);
+            log_info("    IOB TRUE: register '%s' in the output logic of port '%s'\n", ctx->nameOf(ci),
+                     ctx->nameOf(out_pad));
+            outputs++;
+        }
+    }
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        if (ci->type == id_PAD && is_true(ci, id_IOB) && !packed_pads.count(ci->name))
+            log_warning("IOB TRUE on port '%s': no register next to it to move into the I/O logic\n",
+                        ctx->nameOf(ci));
+    }
+    if (inputs + outputs > 0)
+        log_info("IOB TRUE: %d input and %d output register(s) in the I/O logic\n", inputs, outputs);
+}
