+void XilinxImpl::route_to_partition_pins()
+{
+    if (!ctx->args.options.count("partition-pins-route"))
+        return;
+    pool<Loc> closed;
+    for (auto &region : ctx->region)
+        if (region.second->constr_pips)
+            for (auto l : region.second->piplocs)
+                closed.insert(l);
+    pool<WireId> reserved;
+    for (auto &pp : partition_pin_wires)
+        reserved.insert(pp.second);
+    auto in_contained_pblock = [](const CellInfo *ci) {
+        return ci != nullptr && ci->region != nullptr && ci->region->constr_pips;
+    };
+    int to_pin = 0, from_pin = 0, skipped = 0, pips = 0;
+    std::vector<IdString> failed;
+    std::vector<PipId> path;
+    int visits = 0;
+    auto note_failure = [&](NetInfo *ni, WireId target) {
+        log_info("Partition pins: net '%s': no route outside the pblocks to %s (%d wires visited)\n",
+                 ni->name.c_str(ctx), ctx->nameOfWire(target), visits);
+    };
+    for (auto &pp : partition_pin_wires) {
+        auto it = ctx->nets.find(pp.first);
+        const bool this_design_has_no_such_net = (it == ctx->nets.end());
+        if (this_design_has_no_such_net)
+            continue;
+        NetInfo *ni = it->second.get();
+        bool net_has_a_cell_in_a_pblock = in_contained_pblock(ni->driver.cell);
+        for (auto &usr : ni->users)
+            net_has_a_cell_in_a_pblock |= in_contained_pblock(usr.cell);
+        const bool route_reaches_the_pin = ni->wires.count(pp.second) != 0;
+        if (net_has_a_cell_in_a_pblock || route_reaches_the_pin) {
+            skipped++;
+            continue;
+        }
+        const bool net_is_driven = (ni->driver.cell != nullptr);
+        if (net_is_driven) {
+            WireId src = ctx->getNetinfoSourceWire(ni);
+            const bool source_has_no_wire = (src == WireId());
+            if (source_has_no_wire) {
+                failed.push_back(ni->name);
+                continue;
+            }
+            if (!ni->wires.count(src))
+                ctx->bindWire(src, ni, STRENGTH_LOCKED);
+            if (!route_outside_pblocks(ni, pp.second, closed, reserved, path, visits)) {
+                note_failure(ni, pp.second);
+                failed.push_back(ni->name);
+                continue;
+            }
+            for (PipId p : path)
+                ctx->bindPip(p, ni, STRENGTH_LOCKED);
+            pips += path.size();
+            to_pin++;
+            continue;
+        }
+        ctx->bindWire(pp.second, ni, STRENGTH_LOCKED);
+        bool every_sink_reached = true;
+        for (auto &usr : ni->users)
+            for (int i = 0; i < int(ctx->getNetinfoSinkWireCount(ni, usr)); i++) {
+                WireId sink = ctx->getNetinfoSinkWire(ni, usr, i);
+                if (ni->wires.count(sink))
+                    continue;
+                if (!route_outside_pblocks(ni, sink, closed, reserved, path, visits)) {
+                    note_failure(ni, sink);
+                    every_sink_reached = false;
+                    continue;
+                }
+                for (PipId p : path)
+                    ctx->bindPip(p, ni, STRENGTH_LOCKED);
+                pips += path.size();
+            }
+        if (every_sink_reached)
+            from_pin++;
+        else
+            failed.push_back(ni->name);
+    }
+    log_info("Partition pins: %d net(s) routed from their source to the pin, %d from the pin to their sinks, outside "
+             "the pblocks (%d pips, locked); %d reach their pin already or have a cell in a pblock.\n",
+             to_pin, from_pin, pips, skipped);
+    if (!failed.empty())
+        log_error("Partition pins: no route outside the pblocks for %d net(s), e.g. '%s'\n", int(failed.size()),
+                  failed.front().c_str(ctx));
+}
