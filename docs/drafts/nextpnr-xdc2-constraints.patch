+void XilinxImpl::apply_xdc_path_exceptions()
+{
+    auto packed_pin = [&](CellInfo *ci, IdString pin) {
+        if (ci->ports.count(pin))
+            return pin;
+        const std::string &p = pin.str(ctx);
+        if (p == "C" && ci->ports.count(id_CK))
+            return id_CK;
+        const bool is_set_reset = p == "R" || p == "S" || p == "CLR" || p == "PRE";
+        if (is_set_reset && ci->ports.count(id_SR))
+            return id_SR;
+        const bool is_lut_input = p.size() == 2 && p[0] == 'I' && p[1] >= '0' && p[1] <= '5';
+        if (is_lut_input && ci->ports.count(ctx->idf("A%d", p[1] - '0' + 1)))
+            return ctx->idf("A%d", p[1] - '0' + 1);
+        return IdString();
+    };
+    for (auto &pe : xdc_path_exceptions) {
+        TimingException ex = pe.ex;
+        auto take_cells = [&](const std::vector<IdString> &names, pool<IdString> &cells) {
+            for (IdString name : names)
+                if (ctx->cells.count(name))
+                    cells.insert(name);
+        };
+        take_cells(pe.from_cells, ex.from_cells);
+        take_cells(pe.to_cells, ex.to_cells);
+        for (auto &pin : pe.through) {
+            if (!ctx->cells.count(pin.first))
+                continue;
+            IdString packed = packed_pin(ctx->cells.at(pin.first).get(), pin.second);
+            if (packed != IdString())
+                ex.through.insert(std::make_pair(pin.first, packed));
+        }
+        const pool<IdString> named_from(pe.from_cells.begin(), pe.from_cells.end());
+        const pool<IdString> named_to(pe.to_cells.begin(), pe.to_cells.end());
+        const pool<std::pair<IdString, IdString>> named_through(pe.through.begin(), pe.through.end());
+        const bool lost_some = ex.from_cells.size() < named_from.size() || ex.to_cells.size() < named_to.size() ||
+                               ex.through.size() < named_through.size();
+        if (lost_some)
+            log_warning("%s: some of its cells or pins are gone after packing; the rest is applied\n",
+                        ex.name.c_str());
+        ctx->timing_exceptions.push_back(ex);
+    }
 }
 
