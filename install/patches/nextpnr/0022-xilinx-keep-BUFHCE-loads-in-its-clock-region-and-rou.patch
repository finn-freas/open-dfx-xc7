From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] xilinx: keep BUFHCE loads in its clock region and route it on
 clock wires

BUFHCE joins BUFIO/BUFR in the pass that constrains a regional buffer's
sinks to the region its clock reaches, and its output is routed by
route_clocks.
---
 himbaechel/uarch/xilinx/pack.cc          | 4 ++--
 himbaechel/uarch/xilinx/pack_clocking.cc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/himbaechel/uarch/xilinx/pack.cc b/himbaechel/uarch/xilinx/pack.cc
index 8cd6b606..31791ed2 100644
--- a/himbaechel/uarch/xilinx/pack.cc
+++ b/himbaechel/uarch/xilinx/pack.cc
@@ -1691,14 +1691,14 @@ void XilinxImpl::pack()
     apply_pblocks_after_packing();
 
     // Now that LUT-FF clusters exist, keep the sinks of every placed regional
-    // buffer (BUFIO/BUFR) inside the clock region that buffer drives.  The
+
     // placer positions a cluster by its root, so the region must land on the
     // root -- walked inside constrain_regional_clock_sinks -- not on the
     // pre-cluster FF, which is why this runs after pack_lutffs() rather than
     // in constrain_bufios() alongside the bel binding.
     for (auto &cell : ctx->cells) {
         CellInfo *ci = cell.second.get();
-        const bool is_regional_buffer = ci->type == id_BUFIO_BUFIO || ci->type == id_BUFR_BUFR;
+        const bool is_regional_buffer = ci->type.in(id_BUFIO_BUFIO, id_BUFR_BUFR, id_BUFHCE_BUFHCE);
         const bool buffer_is_placed = ci->bel != BelId();
         if (is_regional_buffer && buffer_is_placed)
             packer.constrain_regional_clock_sinks(ci);
diff --git a/himbaechel/uarch/xilinx/pack_clocking.cc b/himbaechel/uarch/xilinx/pack_clocking.cc
index bb081213..dbb51fa0 100644
--- a/himbaechel/uarch/xilinx/pack_clocking.cc
+++ b/himbaechel/uarch/xilinx/pack_clocking.cc
@@ -596,7 +596,8 @@ void XilinxImpl::route_clocks()
                                  (*clk_net->users.begin()).cell->type == id_BUFR_BUFR &&
                                  (*clk_net->users.begin()).port == id_I;
         bool is_global = false;
-        if ((clk_net->driver.cell->type.in(id_BUFGCTRL, id_BUFCE_BUFG_PS, id_BUFCE_BUFCE, id_BUFGCE_DIV_BUFGCE_DIV)) &&
+        if ((clk_net->driver.cell->type.in(id_BUFGCTRL, id_BUFCE_BUFG_PS, id_BUFCE_BUFCE, id_BUFGCE_DIV_BUFGCE_DIV,
+                                           id_BUFHCE_BUFHCE)) &&
             clk_net->driver.port == id_O)
             is_global = true;
         else if (driven_by_bufr)
