+static const ClockConstraint *clock_constraint(const Context *ctx, IdString clock)
+{
+    if (clock == IdString() || !ctx->nets.count(clock))
+        return nullptr;
+    return ctx->nets.at(clock)->clkconstr.get();
+}
+
+
+
+static bool is_false_clock_pair(const Context *ctx, IdString launch, IdString capture)
+{
+    const ClockConstraint *lc = clock_constraint(ctx, launch), *cc = clock_constraint(ctx, capture);
+    return lc != nullptr && cc != nullptr && cc->name != IdString() && lc->false_path_to.count(cc->name);
+}
+
+
+static bool is_false_path_cell(const Context *ctx, IdString cell, bool as_endpoint)
+{
+    if (!ctx->cells.count(cell))
+        return false;
+    const auto &attrs = ctx->cells.at(cell)->attrs;
+    return attrs.count(ctx->id(as_endpoint ? "NEXTPNR_FALSE_PATH_TO" : "NEXTPNR_FALSE_PATH_FROM"));
+}
+
+
+
+static bool clock_setup_relationship(const Context *ctx, IdString launch, ClockEdge launch_edge, IdString capture,
+                                     ClockEdge capture_edge, delay_t &relationship)
+{
+    const ClockConstraint *lc = clock_constraint(ctx, launch), *cc = clock_constraint(ctx, capture);
+    if (lc == nullptr || cc == nullptr || launch == capture || is_false_clock_pair(ctx, launch, capture))
+        return false;
+    IdString lroot = lc->master != IdString() ? lc->master : lc->name;
+    IdString croot = cc->master != IdString() ? cc->master : cc->name;
+    if (lroot == IdString() || lroot != croot)
+        return false;
+
+
+    int64_t lp = std::llround(ctx->getDelayNS(lc->period.minDelay()) * 1000.0);
+    int64_t cp = std::llround(ctx->getDelayNS(cc->period.minDelay()) * 1000.0);
+    if (lp <= 0 || cp <= 0)
+        return false;
+    auto first_edge = [&](const ClockConstraint *c, ClockEdge edge) {
+        int64_t t = std::llround(ctx->getDelayNS(c->offset) * 1000.0);
+        if (edge == FALLING_EDGE)
+            t += std::llround(ctx->getDelayNS(c->high.minDelay()) * 1000.0);
+        return t;
+    };
+    auto floor_div = [](int64_t a, int64_t b) { return a >= 0 ? a / b : -((-a + b - 1) / b); };
+    int64_t l0 = first_edge(lc, launch_edge), c0 = first_edge(cc, capture_edge);
+    int64_t span = lp / std::gcd(lp, cp) * cp;
+    int64_t best = std::numeric_limits<int64_t>::max();
+    for (int64_t k = 0; k < 1000 && k * lp < span; k++) {
+        int64_t launch_at = l0 + k * lp;
+        int64_t next_capture = c0 + (floor_div(launch_at - c0, cp) + 1) * cp;
+        best = std::min(best, next_capture - launch_at);
+    }
+    relationship = ctx->getDelayFromNS(best / 1000.0);
+    return true;
+}
