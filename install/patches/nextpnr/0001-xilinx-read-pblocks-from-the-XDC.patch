+    auto get_pblock = [&](const std::string &str) -> XdcPblock * {
+        const bool is_command = str.size() >= 2 && str.front() == '[' && str.back() == ']';
+        std::vector<std::string> split = split_to_args(is_command ? str.substr(1, str.size() - 2) : str, false);
