+    bool hop_is_in_region(int r, PipId pip, const PerWireData &wd) const
+    {
+        const Region *region = route_regions.at(r);
+        if (region->constr_pips) {
+            Loc l = ctx->getPipLocation(pip);
+            auto fnd = route_region_by_tile.find(std::make_pair(l.x, l.y));
+            if (fnd == route_region_by_tile.end() || fnd->second != r)
+                return false;
+        }
+        if (region->constr_wires && wd.route_region != r)
+            return false;
+        return true;
+    }
+
+
+    int hop_region(PipId pip, const PerWireData &wd) const
+    {
+        if (!route_region_by_tile.empty()) {
+            Loc l = ctx->getPipLocation(pip);
+            auto fnd = route_region_by_tile.find(std::make_pair(l.x, l.y));
+            if (fnd != route_region_by_tile.end())
+                return fnd->second;
+        }
+        return wd.route_region;
+    }
+
+    bool hop_allowed_for_arc(const PerArcData &ad, PipId pip, const PerWireData &wd) const
+    {
+        if (route_regions.empty())
+            return true;
+        if (ad.contain_region != -1)
+            return hop_is_in_region(ad.contain_region, pip, wd);
+        if (cfg.region_keep_out) {
+            int r = hop_region(pip, wd);
+            return r == -1 || r == ad.driver_region || r == ad.sink_region;
+        }
+        return true;
+    }
