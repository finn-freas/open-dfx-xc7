+    BelId root_bel_of_pinned_members(CellInfo *root, CellInfo *member)
+    {
+        Loc ml = ctx->getBelLocation(member->bel);
+        Loc off = ctx->getClusterOffset(member);
+        const int rx = ml.x - off.x, ry = ml.y - off.y;
+        const bool root_tile_is_off_the_grid =
+                rx < 0 || ry < 0 || rx >= ctx->getGridDimX() || ry >= ctx->getGridDimY();
+        if (root_tile_is_off_the_grid)
+            return BelId();
+        std::vector<std::pair<CellInfo *, BelId>> placement;
+        for (BelId bel : ctx->getBelsByTile(rx, ry)) {
+            if (!ctx->isValidBelForCellType(root->type, bel))
+                continue;
+            if (!ctx->getClusterPlacement(root->cluster, bel, placement))
+                continue;
+            const bool every_bound_member_stays =
+                    std::all_of(placement.begin(), placement.end(), [](const std::pair<CellInfo *, BelId> &pb) {
+                        return pb.first->bel == BelId() || pb.first->bel == pb.second;
+                    });
+            if (every_bound_member_stays)
+                return bel;
+        }
+        return BelId();
+    }
