set_input_delay -clock eth_clocks_rx -max  0.5 [get_ports {eth_rx_ctl eth_rx_data[*]}]
set_input_delay -clock eth_clocks_rx -min -0.5 [get_ports {eth_rx_ctl eth_rx_data[*]}]
set_input_delay -clock eth_clocks_rx -clock_fall -max  0.5 -add_delay [get_ports {eth_rx_ctl eth_rx_data[*]}]
set_input_delay -clock eth_clocks_rx -clock_fall -min -0.5 -add_delay [get_ports {eth_rx_ctl eth_rx_data[*]}]
create_generated_clock -name eth_tx_fwd -source [get_pins ODDR/C] -multiply_by 1 [get_ports eth_clocks_tx]
set_output_delay -clock eth_tx_fwd -max  1.0 [get_ports {eth_tx_ctl eth_tx_data[*]}]
set_output_delay -clock eth_tx_fwd -min -0.8 [get_ports {eth_tx_ctl eth_tx_data[*]}]
set_output_delay -clock eth_tx_fwd -clock_fall -max  1.0 -add_delay [get_ports {eth_tx_ctl eth_tx_data[*]}]
set_output_delay -clock eth_tx_fwd -clock_fall -min -0.8 -add_delay [get_ports {eth_tx_ctl eth_tx_data[*]}]
