+
+void XilinxImpl::apply_pblocks_after_packing()
+{
+    if (pblocks.empty())
+        return;
+    auto pblock_of = [&](const CellInfo *ci) -> Region * {
+        const bool is_in_a_pblock = ci->region != nullptr && pblocks.count(ci->region->name) != 0;
+        return is_in_a_pblock ? ci->region : nullptr;
+    };
+
+
+
+    int inherited = 0;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        const std::string &name = cell.first.str(ctx);
+        const bool made_by_packing = pblock_prepack_cells.count(name) == 0;
+        if (!made_by_packing || ci->region != nullptr)
+            continue;
+        for (size_t dollar = name.rfind('$'); dollar != std::string::npos && dollar > 0;
+             dollar = name.rfind('$', dollar - 1)) {
+            auto source = pblock_prepack_cells.find(name.substr(0, dollar));
+            const bool prefix_names_a_netlist_cell = source != pblock_prepack_cells.end();
+            if (!prefix_names_a_netlist_cell)
+                continue;
+            const bool source_was_in_a_pblock = source->second != IdString();
+            if (source_was_in_a_pblock) {
+                ci->region = ctx->region.at(source->second).get();
+                inherited++;
+            }
+            break;
+        }
+    }
+
+
+    dict<ClusterId, std::vector<CellInfo *>> cluster_cells;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        const bool is_in_a_cluster = ci->cluster != ClusterId();
+        if (is_in_a_cluster)
+            cluster_cells[ci->cluster].push_back(ci);
+    }
+    int pulled_in = 0;
+    for (auto &cluster : cluster_cells) {
+        Region *cluster_pblock = nullptr;
+        for (CellInfo *ci : cluster.second) {
+            Region *member_pblock = pblock_of(ci);
+            if (member_pblock == nullptr)
+                continue;
+            const bool cluster_spans_two_pblocks = cluster_pblock != nullptr && cluster_pblock != member_pblock;
+            if (cluster_spans_two_pblocks)
+                log_error("cluster '%s' has cells in pblocks '%s' and '%s', but it is placed as one piece\n",
+                          cluster.first.c_str(ctx), cluster_pblock->name.c_str(ctx), member_pblock->name.c_str(ctx));
+            cluster_pblock = member_pblock;
+        }
+        if (cluster_pblock == nullptr)
+            continue;
+        for (CellInfo *ci : cluster.second) {
+            if (ci->region == cluster_pblock)
+                continue;
+
+            const bool is_a_netlist_cell_from_outside = pblock_prepack_cells.count(ci->name.str(ctx)) != 0;
+            if (is_a_netlist_cell_from_outside) {
+                pulled_in++;
+                if (ctx->verbose)
+                    log_info("    '%s' joins pblock '%s' with its cluster '%s'\n", ctx->nameOf(ci),
+                             cluster_pblock->name.c_str(ctx), cluster.first.c_str(ctx));
+            }
+            ci->region = cluster_pblock;
+        }
+    }
+    if (pulled_in > 0)
+        log_warning("%d cell(s) outside any pblock were packed into a cluster with pblock cells, and are now in "
+                    "that pblock (-v lists them)\n",
+                    pulled_in);
+
+
+    dict<std::pair<IdString, IdString>, bool> pblock_has_a_bel_for;
+    dict<IdString, int> member_count;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        Region *pb = pblock_of(ci);
+        if (pb == nullptr)
+            continue;
+        member_count[pb->name]++;
+        if (!pb->constr_bels)
+            continue;
+        auto key = std::make_pair(pb->name, ci->type);
+        if (!pblock_has_a_bel_for.count(key)) {
+            bool found = false;
+            for (BelId bel : pb->bels) {
+                if (ctx->isValidBelForCellType(ci->type, bel)) {
+                    found = true;
+                    break;
+                }
+            }
+            pblock_has_a_bel_for[key] = found;
+        }
+        if (!pblock_has_a_bel_for.at(key))
+            log_error("cell '%s' of type '%s' is in pblock '%s', which has no site for it; give the pblock a "
+                      "range of that site type with resize_pblock -add\n",
+                      ctx->nameOf(ci), ci->type.c_str(ctx), pb->name.c_str(ctx));
+    }
+
+    for (auto &pb : pblocks) {
+        Region *r = ctx->region.at(pb.second.region).get();
+        const int members = member_count.count(pb.first) ? member_count.at(pb.first) : 0;
+        if (!r->constr_bels) {
+            if (members > 0)
+                log_warning("pblock '%s' has %d cell(s) but no sites, so they are placed anywhere\n",
+                            pb.first.c_str(ctx), members);
+            continue;
+        }
+        log_info("pblock '%s': %d cell(s) on %d bel(s)%s\n", pb.first.c_str(ctx), members, int(r->bels.size()),
+                 pb.second.exclusive ? ", exclusive" : "");
+        if (!pb.second.exclusive)
+            continue;
+        for (BelId bel : r->bels) {
+            auto owner = exclusive_pblock_bels.find(bel);
+            const bool overlaps_another_exclusive_pblock = owner != exclusive_pblock_bels.end() && owner->second != r;
+            if (overlaps_another_exclusive_pblock)
+                log_error("EXCLUDE_PLACEMENT pblocks '%s' and '%s' overlap at %s\n", owner->second->name.c_str(ctx),
+                          pb.first.c_str(ctx), ctx->nameOfBel(bel));
+            exclusive_pblock_bels[bel] = r;
+        }
+    }
+
+
+    for (auto &entry : exclusive_pblock_bels) {
+        CellInfo *bound = ctx->getBoundBelCell(entry.first);
+        const bool bound_cell_is_not_a_member = bound != nullptr && bound->region != entry.second;
+        if (bound_cell_is_not_a_member)
+            log_error("cell '%s' was placed at %s by packing, inside EXCLUDE_PLACEMENT pblock '%s', of which it "
+                      "is not a member\n",
+                      ctx->nameOf(bound), ctx->nameOfBel(entry.first), entry.second->name.c_str(ctx));
+    }
+    if (inherited > 0)
+        log_info("pblocks: %d cell(s) made by packing joined the pblock of the cell they were made from\n",
+                 inherited);
