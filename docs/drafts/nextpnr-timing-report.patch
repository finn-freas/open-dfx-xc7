+static Json json_delay_pair(const Context *ctx, delay_t requirement, delay_t slack)
+{
+    return Json::array({ctx->getDelayNS(requirement), ctx->getDelayNS(slack)});
+}
+
+static Json::array json_report_endpoints(const Context *ctx)
+{
+    Json::array endpointsJson;
+    for (const auto &check : ctx->timing_result.endpoint_checks) {
+        const CellInfo *cell = ctx->cells.at(check.cell_port.first).get();
+        auto endpointJson = Json::object({{"cell", check.cell_port.first.c_str(ctx)},
+                                          {"port", check.cell_port.second.c_str(ctx)},
+                                          {"type", cell->type.c_str(ctx)},
+                                          {"from", clock_event_name(ctx, check.clock_pair.start)},
+                                          {"to", clock_event_name(ctx, check.clock_pair.end)},
+                                          {"arrival", Json::array({ctx->getDelayNS(check.arrival.minDelay()),
+                                                                   ctx->getDelayNS(check.arrival.maxDelay())})}});
+        if (!check.untimed.empty())
+            endpointJson["untimed"] = check.untimed;
+        if (!check.exception.empty())
+            endpointJson["exception"] = check.exception;
+        if (check.has_setup)
+            endpointJson["setup"] = json_delay_pair(ctx, check.setup_requirement, check.setup_slack);
+        if (check.has_hold)
+            endpointJson["hold"] = json_delay_pair(ctx, check.hold_requirement, check.hold_slack);
+        endpointsJson.push_back(endpointJson);
+    }
+    return endpointsJson;
+}
+
+static Json::array json_report_paths(const Context *ctx)
+{
+    Json::array pathsJson;
+    for (const auto &path : ctx->timing_result.reported_paths) {
+        auto pathJson = Json::object({{"from", clock_event_name(ctx, path.path.clock_pair.start)},
+                                      {"to", clock_event_name(ctx, path.path.clock_pair.end)},
+                                      {"check", path.is_hold ? "hold" : "setup"},
+                                      {"endpoint", Json::object({{"cell", path.endpoint.first.c_str(ctx)},
+                                                                 {"port", path.endpoint.second.c_str(ctx)}})},
+                                      {"requirement", ctx->getDelayNS(path.requirement)},
+                                      {"slack", ctx->getDelayNS(path.slack)},
+                                      {"path", json_report_path_segments(ctx, path.path)}});
+        if (!path.exception.empty())
+            pathJson["exception"] = path.exception;
+        pathsJson.push_back(pathJson);
+    }
+    return pathsJson;
+}
+
+static Json::array json_report_clocks(const Context *ctx)
+{
+    Json::array clocksJson;
+    for (IdString clock : ctx->timing_result.clock_nets) {
+        auto clockJson = Json::object({{"net", clock.c_str(ctx)}});
+        const NetInfo *net = ctx->nets.count(clock) ? ctx->nets.at(clock).get() : nullptr;
+        if (net != nullptr && net->clkconstr) {
+            const ClockConstraint &cc = *net->clkconstr;
+            clockJson["period"] = ctx->getDelayNS(cc.period.minDelay());
+            clockJson["high"] = ctx->getDelayNS(cc.high.minDelay());
+            clockJson["offset"] = ctx->getDelayNS(cc.offset);
+            if (cc.name != IdString())
+                clockJson["name"] = cc.name.c_str(ctx);
+            if (cc.master != IdString())
+                clockJson["master"] = cc.master.c_str(ctx);
+        }
+        clocksJson.push_back(clockJson);
+    }
+    return clocksJson;
+}
