+
+void TimingAnalyser::assign_pair_exceptions()
+{
+    for (auto &dp : domain_pairs) {
+        const ClockDomainKey &launch = domains.at(dp.key.launch).key;
+        const ClockDomainKey &capture = domains.at(dp.key.capture).key;
+        dp.setup_exception = dp.hold_exception = -1;
+        dp.hold_relationship = 0;
+        dp.has_hold_relationship = false;
+        if (launch.is_async() || capture.is_async())
+            continue;
+        const ClockConstraint *lc = clock_constraint(ctx, launch.clock), *cc = clock_constraint(ctx, capture.clock);
+        auto rank = [&](int k) {
+            TimingException::Kind kind = ctx->timing_exceptions.at(k).kind;
+            return kind == TimingException::FALSE_PATH ? 0 : (kind == TimingException::MULTICYCLE ? 2 : 1);
+        };
+        for (int k = 0; k < int(ctx->timing_exceptions.size()); k++) {
+            const TimingException &ex = ctx->timing_exceptions.at(k);
+            const bool needs_launch_tag = !ex.from_cells.empty() || !ex.through.empty();
+            if (needs_launch_tag && launch.tag != 2 * k + 1)
+                continue;
+            if (!ex.to_cells.empty() && capture.tag != -(k + 2))
+                continue;
+            if (!ex.from_clocks.empty() && (lc == nullptr || !ex.from_clocks.count(lc->name)))
+                continue;
+            if (!ex.to_clocks.empty() && (cc == nullptr || !ex.to_clocks.count(cc->name)))
+                continue;
+            const bool names_any_path = !needs_launch_tag && ex.to_cells.empty() && ex.from_clocks.empty() &&
+                                        ex.to_clocks.empty();
+            if (names_any_path)
+                continue;
+            const bool takes_setup = ex.kind != TimingException::MIN_DELAY;
+            const bool takes_hold = ex.kind == TimingException::FALSE_PATH || ex.kind == TimingException::MIN_DELAY ||
+                                    (ex.kind == TimingException::MAX_DELAY && ex.datapath_only);
+            if (takes_setup && (dp.setup_exception < 0 || rank(k) < rank(dp.setup_exception)))
+                dp.setup_exception = k;
+            if (takes_hold && (dp.hold_exception < 0 || rank(k) < rank(dp.hold_exception)))
+                dp.hold_exception = k;
+        }
+        const bool one_clock = launch.clock == capture.clock && launch.edge == capture.edge;
+        if (one_clock) {
+            dp.has_hold_relationship = true;
+        } else {
+            delay_t relationship;
+            if (clock_hold_relationship(ctx, launch.clock, launch.edge, capture.clock, capture.edge, relationship)) {
+                dp.hold_relationship = relationship;
+                dp.has_hold_relationship = true;
+            }
+        }
+        bool datapath_only = false;
+        if (dp.setup_exception >= 0) {
+            const TimingException &ex = ctx->timing_exceptions.at(dp.setup_exception);
+            datapath_only = ex.datapath_only;
+            if (ex.kind == TimingException::MAX_DELAY)
+                dp.period = DelayPair(ex.value);
+            else if (ex.kind == TimingException::MULTICYCLE && cc != nullptr)
+                dp.period = DelayPair(dp.period.minDelay() + cc->period.minDelay() * (ex.setup_cycles - 1));
+        }
+        if (!datapath_only)
+            dp.period = DelayPair(dp.period.minDelay() - clock_uncertainty(ctx, launch.clock, capture.clock, true));
+    }
+}
+
+delay_t TimingAnalyser::clock_to_clock_delay(domain_id_t pair) const
+{
+    const auto &dp = domain_pairs.at(pair);
+    if (dp.setup_exception >= 0 && ctx->timing_exceptions.at(dp.setup_exception).datapath_only)
+        return 0;
+    auto clocks = std::make_pair(domains.at(dp.key.launch).key.clock, domains.at(dp.key.capture).key.clock);
+    auto found = clock_delays.find(clocks);
+    return found == clock_delays.end() ? 0 : found->second;
+}
+
+
+void TimingAnalyser::build_constrained_path_reports()
+{
+    auto &paths = result.constrained_paths;
+    paths.clear();
+    for (int i = 0; i < int(domain_pairs.size()); i++) {
+        auto &dp = domain_pairs.at(i);
+        const ClockDomainKey &launch = domains.at(dp.key.launch).key;
+        const ClockDomainKey &capture = domains.at(dp.key.capture).key;
+        auto add_worst = [&](const std::string &what, const std::vector<CellPortKey> &eps,
+                             const dict<CellPortKey, IoDelay> *io_ports) {
+            bool found = false;
+            TimingResult::ConstrainedPath worst;
+            for (auto &ep : eps) {
+                auto &pd = ports.at(ep);
+                if (!pd.domain_pairs.count(i))
+                    continue;
+                delay_t delay = -pd.domain_pairs.at(i).setup_slack;
+                if (found && delay <= worst.delay)
+                    continue;
+                found = true;
+                worst.delay = delay;
+                worst.endpoint = io_ports != nullptr ? io_ports->at(ep).port : ep.cell;
+                if (io_ports != nullptr)
+                    worst.clock_latency = io_clock_latency.at(io_ports->at(ep).domain);
+            }
+            if (!found)
+                return;
+            worst.what = what;
+            worst.clock_pair.start.clock = launch.clock;
+            worst.clock_pair.start.edge = launch.edge;
+            worst.clock_pair.end.clock = capture.clock;
+            worst.clock_pair.end.edge = capture.edge;
+            worst.requirement = dp.period.minDelay();
+            paths.push_back(worst);
+        };
+
+
+        const bool new_hold_check = !launch.is_async() && !setup_only &&
+                                    (dp.hold_exception >= 0 ||
+                                     (dp.has_hold_relationship && launch.clock != capture.clock));
+        const bool hold_is_false = dp.hold_exception >= 0 &&
+                                   ctx->timing_exceptions.at(dp.hold_exception).kind != TimingException::MIN_DELAY;
+        if (new_hold_check && !hold_is_false && !is_false_clock_pair(ctx, launch.clock, capture.clock)) {
+            TimingResult::ConstrainedPath worst;
+            bool found = false;
+            for (auto &ep : domains.at(dp.key.capture).endpoints) {
+                auto &pd = ports.at(ep.first);
+                if (!pd.domain_pairs.count(i))
+                    continue;
+                delay_t slack = pd.domain_pairs.at(i).hold_slack;
+                if (found && slack >= worst.delay)
+                    continue;
+                found = true;
+                worst.delay = slack;
+                worst.endpoint = ep.first.cell;
+            }
+            if (found) {
+                worst.is_hold = true;
+                worst.requirement = dp.hold_exception >= 0
+                                            ? ctx->timing_exceptions.at(dp.hold_exception).value
+                                            : dp.hold_relationship + clock_uncertainty(ctx, launch.clock, capture.clock,
+                                                                                         false);
+                worst.what = dp.hold_exception >= 0 ? ctx->timing_exceptions.at(dp.hold_exception).name : "hold";
+                worst.clock_pair.start.clock = launch.clock;
+                worst.clock_pair.start.edge = launch.edge;
+                worst.clock_pair.end.clock = capture.clock;
+                worst.clock_pair.end.edge = capture.edge;
+                paths.push_back(worst);
+            }
+        }
+        if (dp.setup_exception >= 0) {
+            const TimingException &ex = ctx->timing_exceptions.at(dp.setup_exception);
+            if (ex.kind == TimingException::FALSE_PATH)
+                continue;
+            std::vector<CellPortKey> eps;
+            for (auto &ep : domains.at(dp.key.capture).endpoints)
+                eps.push_back(ep.first);
+            add_worst(ex.name, eps, nullptr);
+            continue;
+        }
+        std::vector<CellPortKey> out_eps, in_sps;
+        for (auto &io : io_ends)
+            if (io.second.domain == dp.key.capture)
+                out_eps.push_back(io.first);
+        for (auto &io : io_starts)
+            if (io.second.domain == dp.key.launch)
+                in_sps.push_back(io.first);
+        if (!out_eps.empty())
+            add_worst("set_output_delay", out_eps, &io_ends);
+        if (!in_sps.empty())
+            add_worst("set_input_delay", in_sps, &io_starts);
+    }
+}
+
+
+
+void TimingAnalyser::setup_io_delays()
+{
+    io_starts.clear();
+    io_ends.clear();
+    const IdString id_in = ctx->id("NEXTPNR_INPUT_DELAY"), id_out = ctx->id("NEXTPNR_OUTPUT_DELAY");
+    dict<IdString, NetInfo *> clock_net_by_name;
+    auto clock_net = [&](IdString name) -> NetInfo * {
+        auto cached = clock_net_by_name.find(name);
+        if (cached != clock_net_by_name.end())
+            return cached->second;
+        NetInfo *best = nullptr;
+        int best_sinks = 0;
+        for (auto &net : ctx->nets) {
+            NetInfo *ni = net.second.get();
+            if (ni->clkconstr == nullptr || ni->clkconstr->name != name)
+                continue;
+            int sinks = 0;
+            for (auto &usr : ni->users) {
+                int count = 0;
+                if (ctx->getPortTimingClass(usr.cell, usr.port, count) == TMG_CLOCK_INPUT)
+                    sinks++;
+            }
+            if (best == nullptr || sinks > best_sinks) {
+                best = ni;
+                best_sinks = sinks;
+            }
+        }
+        clock_net_by_name[name] = best;
+        return best;
+    };
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        for (const bool is_output : {false, true}) {
+            auto attr = ci->attrs.find(is_output ? id_out : id_in);
+            if (attr == ci->attrs.end())
+                continue;
+            std::istringstream fields(attr->second.as_string());
+            std::string clock_name;
+            int falling = 0;
+            double min_ns = 0, max_ns = 0;
+            if (!(fields >> clock_name >> falling >> min_ns >> max_ns)) {
+                log_warning("port '%s': malformed %s '%s', the port is not timed\n", ctx->nameOf(ci),
+                            (is_output ? id_out : id_in).c_str(ctx), attr->second.as_string().c_str());
+                continue;
+            }
+            NetInfo *clk = clock_net(ctx->id(clock_name));
+            if (clk == nullptr) {
+                log_warning("port '%s': clock '%s' of its %s delay is none of this design's clocks, so the port "
+                            "is not timed\n",
+                            ctx->nameOf(ci), clock_name.c_str(), is_output ? "output" : "input");
+                continue;
+            }
+            domain_id_t dom = domain_id(clk, falling ? FALLING_EDGE : RISING_EDGE);
+            DelayPair delay(ctx->getDelayFromNS(min_ns), ctx->getDelayFromNS(max_ns));
+            for (auto &port : ci->ports) {
+                NetInfo *pad_net = port.second.net;
+                if (pad_net == nullptr)
+                    continue;
+
+                auto buffer_pins = [&](CellInfo *buf, IdString pad_pin) {
+                    std::vector<std::pair<IdString, DelayPair>> pins;
+                    for (auto &other : buf->ports) {
+                        const bool away = is_output ? other.second.type == PORT_IN : other.second.type == PORT_OUT;
+                        if (!away || other.second.net == nullptr || other.first == pad_pin)
+                            continue;
+                        DelayQuad arc;
+                        bool has_arc = is_output ? ctx->getCellDelay(buf, other.first, pad_pin, arc)
+                                                 : ctx->getCellDelay(buf, pad_pin, other.first, arc);
+                        pins.emplace_back(other.first, has_arc ? arc.delayPair() : DelayPair(0));
+                    }
+                    return pins;
+                };
+                if (!is_output) {
+                    for (auto &usr : pad_net->users) {
+                        if (usr.cell == ci)
+                            continue;
+                        for (auto &pin : buffer_pins(usr.cell, usr.port)) {
+                            CellPortKey key(usr.cell->name, pin.first);
+                            io_starts[key] = IoDelay{dom, delay, pin.second, ci->name};
+                            ports.at(key).arrival[dom];
+                            domains.at(dom).startpoints.emplace_back(key, IdString());
+                        }
+                    }
+                } else if (pad_net->driver.cell != nullptr && pad_net->driver.cell != ci) {
+                    CellInfo *buf = pad_net->driver.cell;
+                    for (auto &pin : buffer_pins(buf, pad_net->driver.port)) {
+                        CellPortKey key(buf->name, pin.first);
+                        io_ends[key] = IoDelay{dom, delay, pin.second, ci->name};
+                        ports.at(key).required[dom];
+                        domains.at(dom).endpoints.emplace_back(key, IdString());
+                    }
+                }
+            }
+        }
+    }
+}
+
+
+
+DelayPair TimingAnalyser::clock_source_latency(const NetInfo *clock)
+{
+    delay_t lo = 0, hi = 0;
+    if (!with_clock_skew) {
+        bool first = true;
+        for (auto &usr : clock->users) {
+            int count = 0;
+            if (clock->driver.cell == nullptr || clock->driver.cell->bel == BelId() || usr.cell->bel == BelId())
+                continue;
+            if (ctx->getPortTimingClass(usr.cell, usr.port, count) != TMG_CLOCK_INPUT)
+                continue;
+            delay_t d = ctx->getNetinfoRouteDelay(clock, usr);
+            lo = first ? d : std::min(lo, d);
+            hi = first ? d : std::max(hi, d);
+            first = false;
+        }
+    }
+    const NetInfo *net = clock;
+    pool<IdString> seen;
+    while (net != nullptr && net->driver.cell != nullptr && seen.insert(net->name).second) {
+        CellInfo *drv = net->driver.cell;
+        const NetInfo *upstream = nullptr;
+        for (auto &port : drv->ports) {
+            DelayQuad arc;
+            if (port.second.type != PORT_IN || port.second.net == nullptr ||
+                !ctx->getCellDelay(drv, port.first, net->driver.port, arc))
+                continue;
+            lo += arc.minDelay();
+            hi += arc.maxDelay();
+            upstream = port.second.net;
+            const bool placed = upstream->driver.cell != nullptr && upstream->driver.cell->bel != BelId() &&
+                                drv->bel != BelId();
+            if (placed) {
+                delay_t d = ctx->getNetinfoRouteDelay(upstream, PortRef{drv, port.first});
+                lo += d;
+                hi += d;
+            }
+            break;
+        }
+        net = upstream;
+    }
+    return DelayPair(lo, hi);
+}
+
+void TimingAnalyser::update_io_clock_latency()
+{
+    io_clock_latency.clear();
+    for (auto *ios : {&io_starts, &io_ends})
+        for (auto &io : *ios) {
+            if (io_clock_latency.count(io.second.domain))
+                continue;
+            const NetInfo *clk = ctx->nets.at(domains.at(io.second.domain).key.clock).get();
+            io_clock_latency[io.second.domain] = clock_source_latency(clk);
+        }
+}
