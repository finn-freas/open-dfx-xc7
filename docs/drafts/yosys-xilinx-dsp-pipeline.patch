+static SigSpec dsp_unextend(const SigSpec &sig)
+{
+	int i;
+	for (i = GetSize(sig)-1; i > 0; i--)
+		if (sig[i] != sig[i-1])
+			break;
+
+	if (sig[i].wire)
+		++i;
+	return sig.extract(0, i);
+}
