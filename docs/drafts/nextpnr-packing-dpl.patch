+#include <algorithm>
+#include <cmath>
+#include "log.h"
+#include "nextpnr.h"
+#include "timing.h"
+#include "util.h"
+#include "xilinx.h"
+
+#define HIMBAECHEL_CONSTIDS "uarch/xilinx/constids.inc"
+#include "himbaechel_constids.h"
+
+NEXTPNR_NAMESPACE_BEGIN
+
+namespace {
+struct DetailPlacer
+{
+    Context *ctx;
+    XilinxImpl *impl;
+    TimingAnalyser tmg;
+    int radius = 2;
+    int passes = 3;
+    float crit_min = 0.8f;
+    float crit_exp = 4.0f;
+    int max_fanout = 32;
+
+    DetailPlacer(Context *ctx, XilinxImpl *impl) : ctx(ctx), impl(impl), tmg(ctx) {}
+
+    bool movable(const CellInfo *ci) const
+    {
+        if (ci == nullptr || ci->bel == BelId())
+            return false;
+        if (!ci->type.in(id_SLICE_LUTX, id_SLICE_FFX))
+            return false;
+        if (ci->cluster != ClusterId() || ci->belStrength > STRENGTH_STRONG || ci->region != nullptr)
+            return false;
+        if (ci->attrs.count(id_X_LUT_AS_DRAM) || ci->attrs.count(id_X_LUT_AS_SRL))
+            return false;
+        return true;
+    }
+
+    delay_t arc_delay(BelId sb, IdString sp, BelId db, IdString dp) const
+    {
+        if (sb == BelId() || db == BelId())
+            return 0;
+        if (dp == id_CIN && sp == id_CO3)
+            return 0;
+        if (sb.tile == db.tile) {
+            Loc sl = ctx->getBelLocation(sb), dl = ctx->getBelLocation(db);
+            const bool same_position = (sl.z >> 4) == (dl.z >> 4);
+            const int st = sl.z & 0xF, dt = dl.z & 0xF;
+            const bool lut_src = st == BEL_6LUT || st == BEL_5LUT;
+            const bool ff_dst = dt == BEL_FF || dt == BEL_FF2;
+            if (same_position && lut_src && ff_dst && dp == id_D)
+                return 0;
+            if ((sl.z >> 6) == (dl.z >> 6))
+                return 665;
+            return 682;
+        }
+        return 313 + delay_t(1.235 * impl->predictDelay(sb, sp, db, dp));
+    }
+
+    float weight(float crit) const { return 0.02f + std::pow(std::max(0.0f, crit), crit_exp); }
+
+    double cost(const CellInfo *ci) const
+    {
+        double c = 0;
+        for (auto &port : ci->ports) {
+            if (port.first.in(id_CK, id_CLK))
+                continue;
+            NetInfo *ni = port.second.net;
+            if (ni == nullptr || ni->driver.cell == nullptr)
+                continue;
+            if (int(ni->users.entries()) > max_fanout)
+                continue;
+            if (port.second.type == PORT_IN) {
+                float cr = tmg.get_criticality(CellPortKey(ci->name, port.first));
+                c += weight(cr) * arc_delay(ni->driver.cell->bel, ni->driver.port, ci->bel, port.first);
+            } else if (port.second.type == PORT_OUT) {
+                for (auto &usr : ni->users) {
+                    if (usr.cell == nullptr || usr.cell->bel == BelId())
+                        continue;
+                    float cr = tmg.get_criticality(CellPortKey(usr));
+                    c += weight(cr) * arc_delay(ci->bel, port.first, usr.cell->bel, usr.port);
+                }
+            }
+        }
+        return c;
+    }
+
+    float cell_crit(const CellInfo *ci) const
+    {
+        float m = 0;
+        for (auto &port : ci->ports) {
+            if (port.first.in(id_CK, id_CLK))
+                continue;
+            NetInfo *ni = port.second.net;
+            if (ni == nullptr || ni->driver.cell == nullptr)
+                continue;
+            if (port.second.type == PORT_IN)
+                m = std::max(m, tmg.get_criticality(CellPortKey(ci->name, port.first)));
+            else if (port.second.type == PORT_OUT && int(ni->users.entries()) <= max_fanout)
+                for (auto &usr : ni->users)
+                    m = std::max(m, tmg.get_criticality(CellPortKey(usr)));
+        }
+        return m;
+    }
+
+    bool centre(const CellInfo *ci, int &cx, int &cy) const
+    {
+        double sx = 0, sy = 0, sw = 0;
+        auto add = [&](BelId b, float cr) {
+            if (b == BelId())
+                return;
+            Loc l = ctx->getBelLocation(b);
+            double w = weight(cr);
+            sx += w * l.x;
+            sy += w * l.y;
+            sw += w;
+        };
+        for (auto &port : ci->ports) {
+            if (port.first.in(id_CK, id_CLK))
+                continue;
+            NetInfo *ni = port.second.net;
+            if (ni == nullptr || ni->driver.cell == nullptr || int(ni->users.entries()) > max_fanout)
+                continue;
+            if (port.second.type == PORT_IN)
+                add(ni->driver.cell->bel, tmg.get_criticality(CellPortKey(ci->name, port.first)));
+            else if (port.second.type == PORT_OUT)
+                for (auto &usr : ni->users)
+                    if (usr.cell)
+                        add(usr.cell->bel, tmg.get_criticality(CellPortKey(usr)));
+        }
+        if (sw <= 0)
+            return false;
+        cx = int(std::lround(sx / sw));
+        cy = int(std::lround(sy / sw));
+        return true;
+    }
+
+    bool try_bel(CellInfo *ci, BelId nb)
+    {
+        BelId ob = ci->bel;
+        if (nb == ob || !ctx->isValidBelForCellType(ci->type, nb))
+            return false;
+        CellInfo *other = ctx->getBoundBelCell(nb);
+        if (other != nullptr && (!movable(other) || other->type != ci->type))
+            return false;
+        if (other == nullptr && !ctx->checkBelAvail(nb))
+            return false;
+        double before = cost(ci) + (other ? cost(other) : 0);
+        ctx->unbindBel(ob);
+        if (other)
+            ctx->unbindBel(nb);
+        ctx->bindBel(nb, ci, STRENGTH_WEAK);
+        if (other)
+            ctx->bindBel(ob, other, STRENGTH_WEAK);
+        bool ok = ctx->isBelLocationValid(nb) && ctx->isBelLocationValid(ob);
+        double after = ok ? cost(ci) + (other ? cost(other) : 0) : 0;
+        if (ok && after < before - 1.0)
+            return true;
+        ctx->unbindBel(nb);
+        if (other)
+            ctx->unbindBel(ob);
+        ctx->bindBel(ob, ci, STRENGTH_WEAK);
+        if (other)
+            ctx->bindBel(nb, other, STRENGTH_WEAK);
+        return false;
+    }
+
+    int improve(CellInfo *ci)
+    {
+        int cx, cy;
+        if (!centre(ci, cx, cy))
+            return 0;
+        Loc cur = ctx->getBelLocation(ci->bel);
+        std::vector<std::pair<int, BelId>> targets;
+        for (int dy = -radius; dy <= radius; dy++)
+            for (int dx = -radius; dx <= radius; dx++) {
+                int x = cx + dx, y = cy + dy;
+                if (x < 0 || y < 0 || x >= ctx->getGridDimX() || y >= ctx->getGridDimY())
+                    continue;
+                for (BelId b : ctx->getBelsByTile(x, y))
+                    if (ctx->isValidBelForCellType(ci->type, b))
+                        targets.emplace_back(std::abs(dx) + std::abs(dy), b);
+            }
+        std::stable_sort(targets.begin(), targets.end(),
+                         [](const std::pair<int, BelId> &a, const std::pair<int, BelId> &b) { return a.first < b.first; });
+        int moved = 0;
+        for (auto &t : targets) {
+            if (t.second == ci->bel)
+                continue;
+            Loc tl = ctx->getBelLocation(t.second);
+            if (tl.x == cur.x && tl.y == cur.y && (tl.z >> 6) == (cur.z >> 6) && ci->type == id_SLICE_FFX)
+                continue;
+            if (try_bel(ci, t.second)) {
+                moved++;
+                cur = ctx->getBelLocation(ci->bel);
+            }
+        }
+        return moved;
+    }
+
+
+
+
+    bool cluster_movable(const CellInfo *ci) const
+    {
+        if (ci == nullptr || ci->bel == BelId() || ci->cluster != ci->name || ci->constr_children.empty())
+            return false;
+        if (ci->constr_children.size() > 3 || ci->belStrength > STRENGTH_STRONG || ci->region != nullptr)
+            return false;
+        if (ci->type != id_SLICE_LUTX || ci->attrs.count(id_X_LUT_AS_DRAM) || ci->attrs.count(id_X_LUT_AS_SRL))
+            return false;
+        for (auto *ch : ci->constr_children)
+            if (!ch->type.in(id_SLICE_LUTX, id_SLICE_FFX) || ch->bel == BelId() || ch->belStrength > STRENGTH_STRONG)
+                return false;
+        return true;
+    }
+
+    std::vector<CellInfo *> members(CellInfo *root) const
+    {
+        std::vector<CellInfo *> m{root};
+        for (auto *ch : root->constr_children)
+            m.push_back(ch);
+        return m;
+    }
+
+    bool try_cluster(CellInfo *root, BelId nb)
+    {
+        if (nb == root->bel || !ctx->isValidBelForCellType(root->type, nb))
+            return false;
+        std::vector<std::pair<CellInfo *, BelId>> target;
+        if (!ctx->getClusterPlacement(root->cluster, nb, target))
+            return false;
+        auto mem = members(root);
+        if (target.size() != mem.size())
+            return false;
+        for (auto &t : target)
+            if (t.second == BelId() || !ctx->checkBelAvail(t.second))
+                return false;
+        double before = 0;
+        for (auto *c : mem)
+            before += cost(c);
+        std::vector<std::pair<CellInfo *, BelId>> old;
+        for (auto *c : mem) {
+            old.emplace_back(c, c->bel);
+            ctx->unbindBel(c->bel);
+        }
+        for (auto &t : target)
+            ctx->bindBel(t.second, t.first, STRENGTH_WEAK);
+        bool ok = true;
+        for (auto &t : target)
+            ok = ok && ctx->isBelLocationValid(t.second);
+        for (auto &o : old)
+            ok = ok && ctx->isBelLocationValid(o.second);
+        double after = 0;
+        if (ok)
+            for (auto *c : mem)
+                after += cost(c);
+        if (ok && after < before - 1.0)
+            return true;
+        for (auto &t : target)
+            ctx->unbindBel(t.second);
+        for (auto &o : old)
+            ctx->bindBel(o.second, o.first, STRENGTH_WEAK);
+        return false;
+    }
+
+    int improve_cluster(CellInfo *root)
+    {
+        int cx, cy;
+        double sx = 0, sy = 0;
+        int n = 0;
+        for (auto *c : members(root)) {
+            int x, y;
+            if (centre(c, x, y)) {
+                sx += x;
+                sy += y;
+                n++;
+            }
+        }
+        if (n == 0)
+            return 0;
+        cx = int(std::lround(sx / n));
+        cy = int(std::lround(sy / n));
+        std::vector<std::pair<int, BelId>> targets;
+        for (int dy = -radius; dy <= radius; dy++)
+            for (int dx = -radius; dx <= radius; dx++) {
+                int x = cx + dx, y = cy + dy;
+                if (x < 0 || y < 0 || x >= ctx->getGridDimX() || y >= ctx->getGridDimY())
+                    continue;
+                for (BelId b : ctx->getBelsByTile(x, y))
+                    if (ctx->isValidBelForCellType(root->type, b) && ctx->checkBelAvail(b))
+                        targets.emplace_back(std::abs(dx) + std::abs(dy), b);
+            }
+        std::stable_sort(targets.begin(), targets.end(),
+                         [](const std::pair<int, BelId> &a, const std::pair<int, BelId> &b) { return a.first < b.first; });
+        int moved = 0;
+        for (auto &t : targets)
+            if (try_cluster(root, t.second))
+                moved++;
+        return moved;
+    }
+
+    int move_clusters = 0;
+
+    void run()
+    {
+        const std::string v = ctx->args.options.at("dpl").as<std::string>();
+        if (!v.empty()) {
+            float r = radius, p = passes, c = crit_min, e = crit_exp, k = 0;
+            int n = sscanf(v.c_str(), "%f,%f,%f,%f,%f", &r, &p, &c, &e, &k);
+            if (n >= 5)
+                move_clusters = int(k);
+            if (n >= 1)
+                radius = std::max(1, int(r));
+            if (n >= 2)
+                passes = std::max(1, int(p));
+            if (n >= 3)
+                crit_min = c;
+            if (n >= 4)
+                crit_exp = e;
+        }
+        log_info("Detailed placement (dpl): radius %d, %d passes, criticality >= %.2f, exponent %.1f, clusters %d\n", radius,
+                 passes, crit_min, crit_exp, move_clusters);
+        tmg.setup();
+        for (int pass = 0; pass < passes; pass++) {
+            tmg.run();
+            std::vector<std::pair<float, CellInfo *>> cand;
+            for (auto &cell : ctx->cells) {
+                CellInfo *ci = cell.second.get();
+                const bool as_cluster = move_clusters && cluster_movable(ci);
+                if (!movable(ci) && !as_cluster)
+                    continue;
+                float cr = cell_crit(ci);
+                if (as_cluster)
+                    for (auto *ch : ci->constr_children)
+                        cr = std::max(cr, cell_crit(ch));
+                if (cr >= crit_min)
+                    cand.emplace_back(cr, ci);
+            }
+            std::stable_sort(cand.begin(), cand.end(),
+                             [](const std::pair<float, CellInfo *> &a, const std::pair<float, CellInfo *> &b) {
+                                 return a.first > b.first;
+                             });
+            int moved = 0;
+            for (auto &c : cand)
+                moved += (move_clusters && cluster_movable(c.second)) ? improve_cluster(c.second) : improve(c.second);
+            log_info("    pass %d: %d candidate cells, %d moves/swaps kept\n", pass + 1, int(cand.size()), moved);
+            if (moved == 0)
+                break;
+        }
+    }
+};
+}
+
+void XilinxImpl::detail_place()
+{
+    const bool asked = ctx->args.options.count("dpl");
+    const bool replay = ctx->args.options.count("preplaced") || ctx->args.options.count("prerouted");
+    if (!asked || replay)
+        return;
+    DetailPlacer(ctx, this).run();
+}
+
+NEXTPNR_NAMESPACE_END
