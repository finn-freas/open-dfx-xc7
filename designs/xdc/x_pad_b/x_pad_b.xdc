set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports clk]
create_clock -period 10.000 [get_ports clk]
set_property -dict { PACKAGE_PIN C5 IOSTANDARD LVCMOS33 } [get_ports {i[0]}]
set_property -dict { PACKAGE_PIN M3 IOSTANDARD SSTL135 } [get_ports {i[1]}]
set_property -dict { PACKAGE_PIN K18 IOSTANDARD HSUL_12 } [get_ports {i[2]}]
set_property -dict { PACKAGE_PIN C14 IOSTANDARD LVCMOS25 } [get_ports {i[3]}]
set_property -dict { PACKAGE_PIN C6 IOSTANDARD LVCMOS33 DRIVE 12 SLEW SLOW } [get_ports {o[0]}]
set_property -dict { PACKAGE_PIN N2 IOSTANDARD SSTL135 SLEW SLOW } [get_ports {o[1]}]
set_property -dict { PACKAGE_PIN N1 IOSTANDARD SSTL135 SLEW FAST } [get_ports {o[2]}]
set_property -dict { PACKAGE_PIN K17 IOSTANDARD HSUL_12 SLEW SLOW } [get_ports {o[3]}]
set_property -dict { PACKAGE_PIN D14 IOSTANDARD LVCMOS25 DRIVE 12 SLEW SLOW } [get_ports {o[4]}]
set_property -dict { PACKAGE_PIN L1 IOSTANDARD DIFF_SSTL135 } [get_ports {dip[0]}]
set_property -dict { PACKAGE_PIN M1 IOSTANDARD DIFF_SSTL135 } [get_ports {din[0]}]
set_property -dict { PACKAGE_PIN K3 IOSTANDARD DIFF_SSTL135 SLEW SLOW } [get_ports {dop[0]}]
set_property -dict { PACKAGE_PIN L3 IOSTANDARD DIFF_SSTL135 SLEW SLOW } [get_ports {don[0]}]
set_property INTERNAL_VREF 0.675 [get_iobanks 34]
set_property INTERNAL_VREF 0.6 [get_iobanks 14]
set_input_delay -clock [get_clocks clk] 1.000 [get_ports {i[*] dip[*]}]
set_output_delay -clock [get_clocks clk] 1.000 [get_ports {o[*] dop[*]}]
