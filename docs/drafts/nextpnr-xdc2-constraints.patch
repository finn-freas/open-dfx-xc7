+void XilinxPacker::pack_async_reg_chains()
+{
+    const IdString id_async = ctx->id("ASYNC_REG");
+    auto is_true = [](const Property &p) {
+        if (!p.is_string)
+            return p.as_bool();
+        std::string v = p.as_string();
+        std::transform(v.begin(), v.end(), v.begin(), ::toupper);
+        return v == "TRUE" || v == "1" || v == "YES";
+    };
+    auto is_async_reg = [&](const CellInfo *ci) {
+        if (ci->type != id_SLICE_FFX || ci->cluster != ClusterId())
+            return false;
+        auto attr = ci->attrs.find(id_async);
+        if (attr != ci->attrs.end())
+            return is_true(attr->second);
+        const NetInfo *q = ci->getPort(id_Q);
+        if (q == nullptr)
+            return false;
+        auto net_attr = q->attrs.find(id_async);
+        return net_attr != q->attrs.end() && is_true(net_attr->second);
+    };
+    auto same_control_set = [&](const CellInfo *a, const CellInfo *b) {
+        auto inverted = [](const CellInfo *c) {
+            return bool_or_default(c->params, id_IS_R_INVERTED, false) ||
+                   bool_or_default(c->params, id_IS_S_INVERTED, false) ||
+                   bool_or_default(c->params, id_IS_CLR_INVERTED, false) ||
+                   bool_or_default(c->params, id_IS_PRE_INVERTED, false);
+        };
+        return a->getPort(id_CK) == b->getPort(id_CK) && a->getPort(id_CE) == b->getPort(id_CE) &&
+               a->getPort(id_SR) == b->getPort(id_SR) &&
+               int_or_default(a->params, id_IS_C_INVERTED, 0) == int_or_default(b->params, id_IS_C_INVERTED, 0) &&
+               inverted(a) == inverted(b) && a->attrs.count(id_X_FF_AS_LATCH) == b->attrs.count(id_X_FF_AS_LATCH) &&
+               a->attrs.count(id_X_FFSYNC) == b->attrs.count(id_X_FFSYNC);
+    };
+
+    auto next_stage = [&](const CellInfo *ff) -> CellInfo * {
+        const NetInfo *q = ff->getPort(id_Q);
+        if (q == nullptr)
+            return nullptr;
+        CellInfo *next = nullptr;
+        for (auto &usr : q->users) {
+            if (usr.port != id_D || !is_async_reg(usr.cell) || usr.cell == ff || !same_control_set(ff, usr.cell))
+                continue;
+            if (next != nullptr)
+                return nullptr;
+            next = usr.cell;
+        }
+        return next;
+    };
+    pool<IdString> has_previous;
+    std::vector<CellInfo *> candidates;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        if (!is_async_reg(ci))
+            continue;
+        candidates.push_back(ci);
+        CellInfo *next = next_stage(ci);
+        if (next != nullptr)
+            has_previous.insert(next->name);
+    }
+    int chains = 0, flops = 0;
+    pool<IdString> done;
+    for (CellInfo *head : candidates) {
+        if (has_previous.count(head->name) || done.count(head->name))
+            continue;
+        std::vector<CellInfo *> chain;
+        for (CellInfo *ff = head; ff != nullptr && !done.count(ff->name); ff = next_stage(ff)) {
+            chain.push_back(ff);
+            done.insert(ff->name);
+        }
+        if (chain.size() < 2)
+            continue;
+        for (size_t base = 0; base + 1 < chain.size(); base += 4) {
+            CellInfo *root = chain.at(base);
+            size_t n = std::min<size_t>(4, chain.size() - base);
+            if (n < 2)
+                break;
+            root->cluster = root->name;
+            root->attrs[ctx->id("X_ASYNC_REG_CHAIN")] = std::string("1");
+            for (size_t i = 1; i < n; i++) {
+                CellInfo *ff = chain.at(base + i);
+                ff->cluster = root->name;
+                ff->constr_x = 0;
+                ff->constr_y = 0;
+                ff->constr_z = int(i) << 4;
+                ff->constr_abs_z = false;
+                root->constr_children.push_back(ff);
+            }
+            chains++;
+            flops += int(n);
+        }
+    }
+    if (chains > 0)
+        log_info("Constrained %d ASYNC_REG chain(s) of %d flip-flops to one slice each.\n", chains, flops);
+}
