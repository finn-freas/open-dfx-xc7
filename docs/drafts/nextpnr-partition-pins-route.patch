+bool XilinxImpl::route_outside_pblocks(NetInfo *ni, WireId target, const pool<Loc> &closed,
+                                       const pool<WireId> &reserved, std::vector<PipId> &path, int &visits)
+{
+    struct QueuedWire
+    {
+        WireId wire;
+        delay_t cost, togo;
+        bool operator<(const QueuedWire &other) const { return cost + togo > other.cost + other.togo; }
+    };
+    const int max_visits = 2000000;
+    dict<WireId, std::pair<delay_t, PipId>> visited;
+    std::priority_queue<QueuedWire> queue;
+    for (auto &w : ni->wires) {
+        visited[w.first] = std::make_pair(delay_t(0), PipId());
+        queue.push(QueuedWire{w.first, 0, ctx->estimateDelay(w.first, target)});
+    }
+    visits = 0;
+    while (!queue.empty() && visits < max_visits) {
+        QueuedWire q = queue.top();
+        queue.pop();
+        const bool target_reached = (q.wire == target);
+        if (target_reached)
+            break;
+        const bool wire_was_reached_cheaper_since = (q.cost > visited.at(q.wire).first);
+        if (wire_was_reached_cheaper_since)
+            continue;
+        visits++;
+        for (PipId pip : ctx->getPipsDownhill(q.wire)) {
+            Loc l = ctx->getPipLocation(pip);
+            const bool pip_is_in_a_pblock = closed.count(Loc(l.x, l.y, 0)) != 0;
+            const bool pip_is_a_routethru = chip_pip_info(ctx->chip_info, pip).flags == PIP_LUT_ROUTETHRU;
+            if (pip_is_in_a_pblock || pip_is_a_routethru || !ctx->checkPipAvailForNet(pip, ni))
+                continue;
+            WireId dst = ctx->getPipDstWire(pip);
+            const bool wire_is_taken = (ctx->getBoundWireNet(dst) != nullptr);
+            const bool wire_is_another_pin = (dst != target && reserved.count(dst));
+            if (wire_is_taken || wire_is_another_pin)
+                continue;
+            delay_t cost = q.cost + ctx->getPipDelay(pip).maxDelay() + ctx->getWireDelay(dst).maxDelay() +
+                           ctx->getDelayEpsilon();
+            auto it = visited.find(dst);
+            const bool wire_has_a_cheaper_way = (it != visited.end() && it->second.first <= cost);
+            if (wire_has_a_cheaper_way)
+                continue;
+            visited[dst] = std::make_pair(cost, pip);
+            queue.push(QueuedWire{dst, cost, ctx->estimateDelay(dst, target)});
+        }
+    }
+    if (!visited.count(target))
+        return false;
+    path.clear();
+    for (WireId cur = target; visited.at(cur).second != PipId(); cur = ctx->getPipSrcWire(visited.at(cur).second))
+        path.push_back(visited.at(cur).second);
+    std::reverse(path.begin(), path.end());
+    return true;
+}
