+void TimingAnalyser::setup_exceptions()
+{
+    exception_from_cell.clear();
+    exception_to_cell.clear();
+    exception_through.clear();
+    through_domain_map.clear();
+    auto priority = [&](int k) {
+        TimingException::Kind kind = ctx->timing_exceptions.at(k).kind;
+        int rank = kind == TimingException::FALSE_PATH ? 0 : (kind == TimingException::MULTICYCLE ? 2 : 1);
+        return std::make_pair(rank, k);
+    };
+    auto claim = [&](dict<IdString, int> &by_cell, IdString cell, int k) {
+        auto found = by_cell.find(cell);
+        if (found == by_cell.end() || priority(k) < priority(found->second))
+            by_cell[cell] = k;
+    };
+    for (int k = 0; k < int(ctx->timing_exceptions.size()); k++) {
+        const TimingException &ex = ctx->timing_exceptions.at(k);
+        for (IdString cell : ex.from_cells)
+            claim(exception_from_cell, cell, k);
+        for (IdString cell : ex.to_cells)
+            claim(exception_to_cell, cell, k);
+        for (auto &pin : ex.through)
+            if (ports.count(CellPortKey(pin.first, pin.second)))
+                exception_through[CellPortKey(pin.first, pin.second)].push_back(k);
+    }
+}
