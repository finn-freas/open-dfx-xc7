+    const bool xdc_has_a_pblock = !pblocks.empty();
+    if (xdc_has_a_pblock)
+        for (auto &cell : ctx->cells)
+            pblock_prepack_cells[cell.first.str(ctx)] =
+                    cell.second->region != nullptr ? cell.second->region->name : IdString();
+}
