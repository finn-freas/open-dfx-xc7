+void XilinxImpl::apply_place_import()
+{
+    const ArchArgs &args = ctx->args;
+    if (!args.options.count("place-import"))
+        return;
+    std::string path = args.options.at("place-import").as<std::string>();
+    std::ifstream in(path);
+    if (!in)
+        log_error("cannot read place-import file '%s'\n", path.c_str());
+    int bound = 0, no_cell = 0, no_bel = 0, busy = 0, illegal = 0, child = 0, cl_fail = 0, cl_moved = 0;
+    dict<IdString, BelId> want;
+    std::vector<IdString> order;
+    std::string line;
+    while (std::getline(in, line)) {
+        auto tab = line.find('\t');
+        if (tab == std::string::npos)
+            continue;
+        IdString cn = ctx->id(line.substr(0, tab));
+        if (!ctx->cells.count(cn)) {
+            no_cell++;
+            continue;
+        }
+        BelId bel = ctx->getBelByNameStr(line.substr(tab + 1));
+        if (bel == BelId()) {
+            if (no_bel < 10)
+                log_info("place-import: no bel '%s'\n", line.substr(tab + 1).c_str());
+            no_bel++;
+            continue;
+        }
+        want[cn] = bel;
+        order.push_back(cn);
+    }
+    auto tile_ok = [&](BelId b) { return isBelLocationValid(b); };
+    for (int pass = 0; pass < 2; pass++) {
+        for (IdString cn : order) {
+            CellInfo *ci = ctx->cells.at(cn).get();
+            if (ci->bel != BelId())
+                continue;
+            BelId bel = want.at(cn);
+            bool is_root = ci->cluster != ClusterId() && ci->cluster == ci->name;
+            bool is_child = ci->cluster != ClusterId() && ci->cluster != ci->name;
+            if ((pass == 0) != is_root)
+                continue;
+            if (is_child) {
+                child++;
+                continue;
+            }
+            if (is_root) {
+                std::vector<std::pair<CellInfo *, BelId>> placement;
+                bool ok = ctx->getClusterPlacement(ci->cluster, bel, placement);
+                std::string why = ok ? "" : "no cluster placement at the root bel";
+                for (auto &p : placement) {
+                    if (!ok)
+                        break;
+                    if (p.second == BelId()) {
+                        ok = false;
+                        why = stringf("no bel for %s", ctx->nameOf(p.first));
+                    } else if (!ctx->checkBelAvail(p.second)) {
+                        ok = false;
+                        CellInfo *holder = ctx->getBoundBelCell(p.second);
+                        why = stringf("%s wants %s, held by %s", ctx->nameOf(p.first), ctx->nameOfBel(p.second),
+                                      holder ? ctx->nameOf(holder) : "?");
+                    } else if (!ctx->isValidBelForCellType(p.first->type, p.second)) {
+                        ok = false;
+                        why = stringf("%s cannot go on %s", ctx->nameOf(p.first), ctx->nameOfBel(p.second));
+                    }
+                }
+                if (!ok) {
+                    if (cl_fail < 10)
+                        log_info("place-import: cluster %s not placed: %s\n", ctx->nameOf(ci), why.c_str());
+                    cl_fail++;
+                    continue;
+                }
+                for (auto &p : placement)
+                    ctx->bindBel(p.second, p.first, STRENGTH_LOCKED);
+                bool legal = true;
+                for (auto &p : placement)
+                    legal = legal && tile_ok(p.second);
+                if (!legal) {
+                    if (cl_fail < 10)
+                        log_info("place-import: cluster %s not placed: tile not legal with it\n", ctx->nameOf(ci));
+                    for (auto &p : placement)
+                        ctx->unbindBel(p.second);
+                    cl_fail++;
+                    continue;
+                }
+                for (auto &p : placement) {
+                    bound++;
+                    if (p.first != ci && want.count(p.first->name) && want.at(p.first->name) != p.second)
+                        cl_moved++;
+                }
+                continue;
+            }
+            if (!ctx->checkBelAvail(bel) || !ctx->isValidBelForCellType(ci->type, bel)) {
+                busy++;
+                continue;
+            }
+            ctx->bindBel(bel, ci, STRENGTH_LOCKED);
+            if (!tile_ok(bel)) {
+                ctx->unbindBel(bel);
+                illegal++;
+                continue;
+            }
+            bound++;
+        }
+    }
+    int left = 0;
+    for (auto &cell : ctx->cells)
+        if (cell.second->bel == BelId())
+            left++;
+    log_info("place-import: %d cell(s) bound; not in design %d, unknown bel %d, bel taken %d, tile illegal %d, "
+             "cluster not placeable %d, cluster member off its imported bel %d; %d cell(s) left to the placer\n",
+             bound, no_cell, no_bel, busy, illegal, cl_fail, cl_moved, left);
+    (void)child;
+}
