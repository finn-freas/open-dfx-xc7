+
+#include <cctype>
+
+#include "log.h"
+#include "nextpnr.h"
+#include "util.h"
+#include "xilinx.h"
+
+#define HIMBAECHEL_CONSTIDS "uarch/xilinx/constids.inc"
+#include "himbaechel_constids.h"
+
+NEXTPNR_NAMESPACE_BEGIN
+
+namespace {
+struct HardblockArc
+{
+    enum Kind
+    {
+        IOPATH,
+        SETUP,
+        HOLD
+    };
+    const char *cell_type;
+    const char *cond;
+    Kind kind;
+    const char *from;
+    const char *to;
+    int32_t min_ps, max_ps;
+};
+
+const HardblockArc hardblock_arcs[] = {
+#include "hardblock_timing.inc"
+};
+
+
+const char *dsp_param_default(const std::string &name)
+{
+    static const dict<std::string, const char *> defaults = {
+            {"ACASCREG", "1"},     {"ADREG", "1"},       {"ALUMODEREG", "1"},        {"AREG", "1"},
+            {"A_INPUT", "DIRECT"}, {"BCASCREG", "1"},    {"BREG", "1"},              {"B_INPUT", "DIRECT"},
+            {"CARRYINREG", "1"},   {"CARRYINSELREG", "1"}, {"CREG", "1"},            {"DREG", "1"},
+            {"INMODEREG", "1"},    {"MREG", "1"},        {"OPMODEREG", "1"},         {"PREG", "1"},
+            {"USE_DPORT", "FALSE"}, {"USE_MULT", "MULTIPLY"}, {"USE_PATTERN_DETECT", "NO_PATDET"},
+    };
+    auto found = defaults.find(name);
+    return found == defaults.end() ? "" : found->second;
+}
+
+bool param_matches(Context *ctx, const CellInfo *ci, const std::string &name, const std::string &value)
+{
+    const char *def = dsp_param_default(name);
+    bool numeric = !value.empty() && std::isdigit(static_cast<unsigned char>(value[0]));
+    if (numeric)
+        return int_or_default(ci->params, ctx->id(name), std::atoi(def)) == std::atoi(value.c_str());
+    return str_or_default(ci->params, ctx->id(name), def) == value;
+}
+
+bool cond_holds(Context *ctx, const CellInfo *ci, const char *cond)
+{
+    std::string c(cond);
+    size_t pos = 0;
+    while (pos < c.size()) {
+        size_t comma = c.find(',', pos);
+        std::string term = c.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        size_t eq = term.find('=');
+        NPNR_ASSERT(eq != std::string::npos);
+        if (!param_matches(ctx, ci, term.substr(0, eq), term.substr(eq + 1)))
+            return false;
+        if (comma == std::string::npos)
+            break;
+        pos = comma + 1;
+    }
+    return true;
+}
+
+void widen(dict<IdString, DelayPair> &m, IdString key, DelayPair d)
+{
+    auto found = m.find(key);
+    if (found == m.end()) {
+        m.emplace(key, d);
+        return;
+    }
+    found->second.min_delay = std::min(found->second.min_delay, d.min_delay);
+    found->second.max_delay = std::max(found->second.max_delay, d.max_delay);
+}
+}
+
+
+
+
+
+IdString XilinxImpl::ramb36_clock_half(const CellInfo *cell, IdString port, IdString clock) const
+{
+    const std::string &p = port.str(ctx);
+    IdString upper = ctx->id(clock.str(ctx) + "U"), lower = ctx->id(clock.str(ctx) + "L");
+    if (!p.empty() && p.back() == 'U' && cell->ports.count(upper))
+        return upper;
+    return cell->ports.count(lower) ? lower : clock;
+}
+
+IdString XilinxImpl::hardblock_bus(IdString port) const
+{
+    if (port.in(id_CEA1, id_CEA2, id_CEB1, id_CEB2))
+        return port;
+    const std::string &s = port.str(ctx);
+    size_t end = s.size();
+    while (end > 0 && std::isdigit(static_cast<unsigned char>(s[end - 1])))
+        end--;
+    return end == s.size() ? port : ctx->id(s.substr(0, end));
+}
+
+void XilinxImpl::init_hardblock_timing()
+{
+    hardblock_timing.clear();
+    hardblock_timing_on = ctx->args.options.count("hardblock-timing");
+    if (!hardblock_timing_on)
+        return;
+    int cells = 0;
+    for (auto &cell : ctx->cells) {
+        CellInfo *ci = cell.second.get();
+        if (!ci->type.in(id_DSP48E1_DSP48E1, id_ICAP_ICAP))
+            continue;
+        HardblockTiming t;
+        const std::string &type = ci->type.str(ctx);
+        for (const auto &arc : hardblock_arcs) {
+            if (type != arc.cell_type || !cond_holds(ctx, ci, arc.cond))
+                continue;
+            DelayPair d(ctx->getDelayFromNS(arc.min_ps / 1000.0), ctx->getDelayFromNS(arc.max_ps / 1000.0));
+            IdString from = ctx->id(arc.from), to = ctx->id(arc.to);
+            if (arc.kind == HardblockArc::SETUP)
+                widen(t.setup, from, d);
+            else if (arc.kind == HardblockArc::HOLD)
+                widen(t.hold, from, d);
+            else if (from == id_CLK)
+                widen(t.clk_q, to, d);
+            else {
+                auto key = std::make_pair(from, to);
+                auto found = t.comb.find(key);
+                if (found == t.comb.end())
+                    t.comb.emplace(key, d);
+                else
+                    found->second = DelayPair(std::min(found->second.min_delay, d.min_delay),
+                                              std::max(found->second.max_delay, d.max_delay));
+            }
+        }
+        for (auto &c : t.comb) {
+            t.comb_in.insert(c.first.first);
+            t.comb_out.insert(c.first.second);
+        }
+        hardblock_timing.emplace(ci->name, std::move(t));
+        cells++;
+    }
+    log_info("hardblock-timing: SDF timing on %d DSP48E1/ICAPE2 cell(s)\n", cells);
+}
+
+const XilinxImpl::HardblockTiming *XilinxImpl::hardblock_timing_of(const CellInfo *cell) const
+{
+    if (hardblock_timing.empty())
+        return nullptr;
+    auto found = hardblock_timing.find(cell->name);
+    return found == hardblock_timing.end() ? nullptr : &found->second;
+}
+
+bool XilinxImpl::getCellDelay(const CellInfo *cell, IdString fromPort, IdString toPort, DelayQuad &delay) const
+{
+    const HardblockTiming *t = hardblock_timing_of(cell);
+    if (t == nullptr)
+        return buffer_cell_delay(cell, fromPort, toPort, delay);
+    auto found = t->comb.find(std::make_pair(hardblock_bus(fromPort), hardblock_bus(toPort)));
+    if (found == t->comb.end())
+        return false;
+    delay = DelayQuad(found->second.min_delay, found->second.max_delay);
+    return true;
+}
+
+TimingPortClass XilinxImpl::getPortTimingClass(const CellInfo *cell, IdString port, int &clockInfoCount) const
+{
+    const HardblockTiming *t = hardblock_timing_of(cell);
+    if (t == nullptr)
+        return ctx->get_port_timing_class_default(cell, port, clockInfoCount);
+    clockInfoCount = 0;
+    IdString bus = hardblock_bus(port);
+    if (bus == id_CLK)
+        return TMG_CLOCK_INPUT;
+    if (cell->ports.at(port).type == PORT_IN) {
+        if (t->setup.count(bus)) {
+            clockInfoCount = 1;
+            return TMG_REGISTER_INPUT;
+        }
+        return t->comb_in.count(bus) ? TMG_COMB_INPUT : TMG_IGNORE;
+    }
+    if (t->clk_q.count(bus)) {
+        clockInfoCount = 1;
+        return TMG_REGISTER_OUTPUT;
+    }
+    return t->comb_out.count(bus) ? TMG_COMB_OUTPUT : TMG_IGNORE;
+}
+
+TimingClockingInfo XilinxImpl::getPortClockingInfo(const CellInfo *cell, IdString port, int index) const
+{
+    const HardblockTiming *t = hardblock_timing_of(cell);
+    if (t == nullptr) {
+        TimingClockingInfo info = ctx->get_port_clocking_info_default(cell, port, index);
+        if (hardblock_timing_on && cell->type == id_RAMB36E1_RAMB36E1 && !cell->ports.count(info.clock_port))
+            info.clock_port = ramb36_clock_half(cell, port, info.clock_port);
+        return info;
+    }
+    TimingClockingInfo info;
+    IdString bus = hardblock_bus(port);
+    info.clock_port = id_CLK;
+    info.edge = RISING_EDGE;
+    auto s = t->setup.find(bus);
+    if (s != t->setup.end()) {
+        info.setup = s->second;
+        auto h = t->hold.find(bus);
+        info.hold = h == t->hold.end() ? DelayPair(0) : h->second;
+    }
+    auto q = t->clk_q.find(bus);
+    if (q != t->clk_q.end())
+        info.clockToQ = DelayQuad(q->second.min_delay, q->second.max_delay);
+    return info;
+}
+
+NEXTPNR_NAMESPACE_END
