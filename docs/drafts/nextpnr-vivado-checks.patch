+TimingPortClass XilinxImpl::getPortTimingClass(const CellInfo *cell, IdString port, int &clockInfoCount) const
+{
+    if (vivado_timing && cell->type == id_SLICE_LUTX && cell->attrs.count(id_X_LUT_AS_SRL)) {
+        if (port == id_CLK)
+            return TMG_CLOCK_INPUT;
+        if (port.in(id_DI1, id_DI2, id_WE)) {
+            clockInfoCount = 1;
+            return TMG_REGISTER_INPUT;
+        }
+        if (port.in(id_O6, id_O5, id_MC31)) {
+            clockInfoCount = 1;
+            return TMG_REGISTER_OUTPUT;
+        }
+    }
+    return HimbaechelAPI::getPortTimingClass(cell, port, clockInfoCount);
+}
+
+TimingClockingInfo XilinxImpl::getPortClockingInfo(const CellInfo *cell, IdString port, int index) const
+{
+    auto ns = [&](double v) { return ctx->getDelayFromNS(v); };
+    if (vivado_timing && cell->type == id_SLICE_LUTX && cell->attrs.count(id_X_LUT_AS_SRL)) {
+        TimingClockingInfo info;
+        info.clock_port = id_CLK;
+        info.edge = int_or_default(cell->params, id_IS_WCLK_INVERTED, 0) ? FALLING_EDGE : RISING_EDGE;
+        info.setup = info.hold = DelayPair(0);
+        if (port == id_DI1) {
+            info.setup = DelayPair(ns(0.170));
+            info.hold = DelayPair(ns(0.093));
+        } else if (port == id_DI2) {
+            info.setup = DelayPair(ns(0.173));
+            info.hold = DelayPair(ns(0.094));
+        } else if (port == id_WE) {
+            info.setup = DelayPair(ns(0.638));
+            info.hold = DelayPair(ns(0.014));
+        } else if (port == id_O6) {
+            info.clockToQ = DelayQuad(ns(1.186), ns(1.472));
+        } else if (port == id_O5) {
+            info.clockToQ = DelayQuad(ns(1.177), ns(1.461));
+        } else if (port == id_MC31) {
+            info.clockToQ = DelayQuad(ns(0.898), ns(1.114));
+        }
+        return info;
+    }
+    TimingClockingInfo info = HimbaechelAPI::getPortClockingInfo(cell, port, index);
+    if (vivado_timing && cell->type == id_SLICE_FFX && port == id_SR) {
+        const std::string orig = str_or_default(cell->attrs, id_X_ORIG_TYPE, "");
+        const bool clr = orig == "FDCE" || orig == "FDCE_1", pre = orig == "FDPE" || orig == "FDPE_1";
+        if (clr || pre) {
+            info.setup = DelayPair(ns(clr ? 0.404 : 0.358));
+            info.hold = DelayPair(ns(-0.248));
+        }
+    }
+    return info;
+}
