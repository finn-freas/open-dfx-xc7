+static bool clock_hold_relationship(const Context *ctx, IdString launch, ClockEdge launch_edge, IdString capture,
+                                    ClockEdge capture_edge, delay_t &relationship)
+{
+    const ClockConstraint *lc = clock_constraint(ctx, launch), *cc = clock_constraint(ctx, capture);
+    if (lc == nullptr || cc == nullptr || launch == capture || is_false_clock_pair(ctx, launch, capture))
+        return false;
+    IdString lroot = lc->master != IdString() ? lc->master : lc->name;
+    IdString croot = cc->master != IdString() ? cc->master : cc->name;
+    if (lroot == IdString() || lroot != croot)
+        return false;
+    int64_t lp = std::llround(ctx->getDelayNS(lc->period.minDelay()) * 1000.0);
+    int64_t cp = std::llround(ctx->getDelayNS(cc->period.minDelay()) * 1000.0);
+    if (lp <= 0 || cp <= 0)
+        return false;
+    auto first_edge = [&](const ClockConstraint *c, ClockEdge edge) {
+        int64_t t = std::llround(ctx->getDelayNS(c->offset) * 1000.0);
+        if (edge == FALLING_EDGE)
+            t += std::llround(ctx->getDelayNS(c->high.minDelay()) * 1000.0);
+        return t;
+    };
+    auto floor_div = [](int64_t a, int64_t b) { return a >= 0 ? a / b : -((-a + b - 1) / b); };
+    int64_t l0 = first_edge(lc, launch_edge), c0 = first_edge(cc, capture_edge);
+    int64_t span = lp / std::gcd(lp, cp) * cp;
+    int64_t worst = std::numeric_limits<int64_t>::lowest();
+    for (int64_t k = 0; k < 1000 && k * lp < span; k++) {
+        int64_t launch_at = l0 + k * lp;
+        int64_t setup_capture = c0 + (floor_div(launch_at - c0, cp) + 1) * cp;
+        worst = std::max(worst, std::max(setup_capture - cp - launch_at, setup_capture - (launch_at + lp)));
+    }
+    relationship = ctx->getDelayFromNS(worst / 1000.0);
+    return true;
+}
+
+
+
+
+static delay_t clock_uncertainty(const Context *ctx, IdString launch, IdString capture, bool setup)
+{
+    const ClockConstraint *lc = clock_constraint(ctx, launch), *cc = clock_constraint(ctx, capture);
+    delay_t uncertainty = cc == nullptr ? 0 : (setup ? cc->setup_uncertainty : cc->hold_uncertainty);
+    auto sj = ctx->settings.find(ctx->id("timing/systemJitter"));
+    if (sj != ctx->settings.end() && cc != nullptr) {
+        double system = std::strtod(sj->second.as_string().c_str(), nullptr);
+        double ijl = lc == nullptr ? 0.0 : ctx->getDelayNS(lc->input_jitter);
+        double ijc = ctx->getDelayNS(cc->input_jitter);
+        double tsj2 = 2.0 * system * system;
+        double tij2 = ijl * ijl + ijc * ijc;
+        uncertainty += ctx->getDelayFromNS(std::sqrt(tsj2 + tij2) / 2.0);
+    }
+    return uncertainty;
+}
