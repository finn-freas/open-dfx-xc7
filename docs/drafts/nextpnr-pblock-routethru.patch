+bool XilinxImpl::is_routethru_closed_to_net(PipId pip, const NetInfo *net) const
+{
+    if (pblock_site_tiles.empty())
+        return false;
+    const auto &pip_data = chip_pip_info(ctx->chip_info, pip);
+    if (pip_data.flags != PIP_LUT_ROUTETHRU)
+        return false;
+    auto owner = pblock_site_tiles.find(pip.tile);
+    if (owner == pblock_site_tiles.end())
+        return false;
+    const bool driver_is_a_member =
+            net != nullptr && net->driver.cell != nullptr && net->driver.cell->region == owner->second;
+    if (!driver_is_a_member)
+        return true;
+    for (auto &usr : net->users)
+        if (usr.cell == nullptr || usr.cell->region != owner->second)
+            return true;
+    return false;
+}
