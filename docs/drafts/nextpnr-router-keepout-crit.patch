+    void exempt_critical_arcs()
+    {
+        if (route_regions.empty() || !cfg.region_keep_out || cfg.region_keep_out_crit >= 1.0f || !timing_driven)
+            return;
+        int exempt = 0, kept = 0;
+        for (auto net : nets_by_udata) {
+            auto &nd = nets.at(net->udata);
+            for (auto usr : net->users.enumerate()) {
+                float crit = tmg.get_criticality(CellPortKey(usr.value));
+                for (auto &ad : nd.arcs.at(usr.index.idx())) {
+                    if (ad.contain_region != -1)
+                        continue;
+                    ad.keep_out_exempt = crit >= cfg.region_keep_out_crit;
+                    if (ad.keep_out_exempt)
+                        ++exempt;
+                    else
+                        ++kept;
+                }
+            }
+        }
+        log_info("Routing regions: %d arc(s) at criticality %.2f or more may cross the regions, %d kept out\n", exempt,
+                 cfg.region_keep_out_crit, kept);
+    }
