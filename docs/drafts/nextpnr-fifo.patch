+        const bool synchronous = str_or_default(ci->params, ctx->id("EN_SYN"), "FALSE") == "TRUE";
+        const bool fwft = str_or_default(ci->params, ctx->id("FIRST_WORD_FALL_THROUGH"), "FALSE") == "TRUE";
