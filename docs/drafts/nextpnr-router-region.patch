+void XilinxImpl::add_pblock_routing_tiles(Region *pb_region)
+{
+    auto tile_type_of = [&](int tile) { return IdString(chip_tile_info(ctx->chip_info, tile).type_name).str(ctx); };
+    auto ends_with = [](const std::string &s, const char *suffix) {
+        const std::string sfx(suffix);
+        return s.size() >= sfx.size() && s.compare(s.size() - sfx.size(), sfx.size(), sfx) == 0;
+    };
+    pool<int> site_tiles;
+    for (BelId bel : pb_region->bels)
+        site_tiles.insert(bel.tile);
+    int unpaired = 0;
+    for (int tile : site_tiles) {
+        int x, y;
+        tile_xy(ctx->chip_info, tile, x, y);
+        pb_region->piplocs.insert(Loc(x, y, 0));
+        const std::string type = tile_type_of(tile);
+        const bool interconnect_is_to_the_right = ends_with(type, "_L");
+        const bool interconnect_is_to_the_left = ends_with(type, "_R");
+        if (!interconnect_is_to_the_right && !interconnect_is_to_the_left) {
+            unpaired++;
+            continue;
+        }
+        const int step = interconnect_is_to_the_right ? 1 : -1;
+        const bool site_tile_is_five_rows_tall = type.compare(0, 4, "BRAM") == 0 || type.compare(0, 3, "DSP") == 0;
+        const int rows = site_tile_is_five_rows_tall ? 5 : 1;
+        int rows_with_interconnect = 0;
+        for (int dy = 0; dy < rows; dy++) {
+            for (int dx = step; std::abs(dx) <= 3; dx += step) {
+                const int nx = x + dx, ny = y - dy;
+                const bool off_the_grid = nx < 0 || ny < 0 || nx >= ctx->getGridDimX() || ny >= ctx->getGridDimY();
+                if (off_the_grid)
+                    break;
+                const std::string ntype = tile_type_of(tile_by_xy(ctx->chip_info, nx, ny));
+                const bool is_interconnect = ntype == "INT_L" || ntype == "INT_R";
+                const bool is_interface = ntype.find("INT_INTERFACE") != std::string::npos;
+                if (!is_interconnect && !is_interface)
+                    break;
+                pb_region->piplocs.insert(Loc(nx, ny, 0));
+                if (is_interconnect) {
+                    rows_with_interconnect++;
+                    break;
+                }
+            }
+        }
+        if (rows_with_interconnect < rows)
+            unpaired++;
+    }
+    pb_region->constr_pips = !pb_region->piplocs.empty();
+    if (unpaired > 0)
+        log_warning("pblock '%s': %d site tile(s) have no interconnect tile found beside them; routes inside the "
+                    "pblock can use only the pips of those tiles themselves\n",
+                    pb_region->name.c_str(ctx), unpaired);
+}
