From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] xilinx: program unused MMCM/PLL outputs as Vivado does

An unconnected CLKOUTn without a DIVIDE parameter gets HIGH_TIME[0],
LOW_TIME[0] and NO_COUNT (FRACTIONAL_NO_COUNT on CLKOUT5/6) instead of
nothing.
---
 himbaechel/uarch/xilinx/fasm.cc | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/himbaechel/uarch/xilinx/fasm.cc b/himbaechel/uarch/xilinx/fasm.cc
index d4375c84..519df3dd 100644
--- a/himbaechel/uarch/xilinx/fasm.cc
+++ b/himbaechel/uarch/xilinx/fasm.cc
@@ -2747,9 +2747,21 @@ struct FasmBackend
                 write_bit(name + "_CLKOUT2_FRAC_EN[0]", edge);
                 write_int_vector(name + "_CLKOUT2_FRAC[2:0]", frac, 3);
             }
+        } else if (!ci->params.count(ctx->id(name + "_DIVIDE"))) {
+            write_unused_clkout(name, name + "_CLKOUT2_NO_COUNT[0]");
         }
     }
 
+
+
+
+    void write_unused_clkout(const std::string &name, const std::string &no_count_feature)
+    {
+        write_int_vector(name + "_CLKOUT1_HIGH_TIME[5:0]", 1, 6);
+        write_int_vector(name + "_CLKOUT1_LOW_TIME[5:0]", 1, 6);
+        write_bit(no_count_feature);
+    }
+
     void write_pll(CellInfo *ci)
     {
         push(uarch->tile_name(ci->bel.tile));
@@ -2947,6 +2959,10 @@ struct FasmBackend
                 write_bit(name + "_CLKOUT2_FRAC_WF_R[0]", frac_wf_r);
                 write_int_vector(name + "_CLKOUT2_FRAC[2:0]", frac, 3);
             }
+        } else if (!ci->params.count(ctx->id(name + "_DIVIDE")) && !ci->params.count(ctx->id(name + "_DIVIDE_F"))) {
+            const bool is_clkout_5_or_6 = name == "CLKOUT5" || name == "CLKOUT6";
+            write_unused_clkout(name,
+                                name + (is_clkout_5_or_6 ? "_CLKOUT2_FRACTIONAL_NO_COUNT[0]" : "_CLKOUT2_NO_COUNT[0]"));
         }
     }
 
