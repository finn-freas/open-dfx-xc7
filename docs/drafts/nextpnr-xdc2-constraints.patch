+    const ClockDomainKey key = domains.at(dom).key;
+    ClockDomainKey tagged{key.clock, key.edge, tag};
+    auto inserted = domain_to_id.emplace(tagged, domains.size());
+    if (inserted.second)
+        domains.emplace_back(tagged);
+    return inserted.first->second;
+}
+
+
+domain_id_t TimingAnalyser::through_domain(const CellPortKey &port, domain_id_t dom, bool create)
+{
+    auto pins = exception_through.find(port);
+    if (pins == exception_through.end())
+        return dom;
+    const int tag = domains.at(dom).key.tag;
+    for (int k : pins->second) {
+        const bool from_matched =
+                tag == 2 * k || (tag == -1 && ctx->timing_exceptions.at(k).from_cells.empty());
+        if (!from_matched)
+            continue;
+        auto key = std::make_pair(dom, k);
+        auto found = through_domain_map.find(key);
+        if (found != through_domain_map.end())
+            return found->second;
+        if (!create)
+            return dom;
+        domain_id_t tagged = tagged_domain(dom, 2 * k + 1);
+        through_domain_map[key] = tagged;
+        return tagged;
+    }
+    return dom;
+}
