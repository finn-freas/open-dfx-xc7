+                if (members.empty())
+                    log_warning("add_cells_to_pblock: %s matched no cells (on line %d)\n", sel.c_str(), lineno);
+                for (CellInfo *ci : members) {
+                    const bool is_in_another_pblock = ci->region != nullptr && ci->region != pb_region;
+                    if (is_in_another_pblock) {
+                        log_nonfatal_error("cell '%s' is already in pblock '%s' (on line %d)\n", ctx->nameOf(ci),
+                                           ci->region->name.c_str(ctx), lineno);
+                        num_errors++;
+                        continue;
+                    }
+
+                    ci->region = pb_region;
+                    added++;
+                }
+            }
+            log_info("add_cells_to_pblock: %d cell(s) in pblock '%s' (on line %d)\n", added, pb->region.c_str(ctx),
+                     lineno);
+        } else if (cmd == "resize_pblock") {
+
+
+
+
+
+            if (arguments.size() < 4) {
+                log_nonfatal_error("expected a pblock and -add <ranges> to 'resize_pblock' (on line %d)\n", lineno);
+                num_errors++;
+                goto nextline;
+            }
+            XdcPblock *pb = get_pblock(arguments.at(1));
+            if (pb == nullptr)
+                goto nextline;
+            struct SiteRange
+            {
+                std::string prefix;
+                IdString site_type;
+                int x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+            };
+            std::vector<SiteRange> ranges;
+
+            auto parse_site = [](const std::string &site, std::string &prefix, int &x, int &y) {
+                size_t xpos = site.rfind("_X");
+                if (xpos == std::string::npos)
+                    return false;
+                size_t ypos = site.find('Y', xpos + 2);
+                if (ypos == std::string::npos)
+                    return false;
+                std::string xs = site.substr(xpos + 2, ypos - xpos - 2), ys = site.substr(ypos + 1);
+                auto is_number = [](const std::string &s) {
+                    return !s.empty() && s.size() <= 6 && std::all_of(s.begin(), s.end(), ::isdigit);
+                };
+                if (!is_number(xs) || !is_number(ys))
+                    return false;
+                prefix = site.substr(0, xpos);
+                x = std::stoi(xs);
+                y = std::stoi(ys);
+                return true;
+            };
+            for (int cursor = 2; cursor < int(arguments.size()); cursor++) {
+                const std::string &opt = arguments.at(cursor);
+                const bool has_value = cursor + 1 < int(arguments.size());
+                const bool is_add = opt == "-add" && has_value;
+                if (!is_add) {
+                    log_nonfatal_error("unsupported resize_pblock argument '%s', only -add <ranges> (on line %d)\n",
+                                       opt.c_str(), lineno);
+                    num_errors++;
+                    goto nextline;
+                }
+                for (const std::string &range : split_to_args(strip_quotes(arguments.at(++cursor)), false)) {
+                    size_t colon = range.find(':');
+                    std::string first = range.substr(0, colon);
+                    std::string last = colon == std::string::npos ? first : range.substr(colon + 1);
+                    SiteRange r;
+                    std::string last_prefix;
+                    const bool both_ends_are_sites = parse_site(first, r.prefix, r.x0, r.y0) &&
+                                                     parse_site(last, last_prefix, r.x1, r.y1);
+                    const bool ends_share_a_site_type = both_ends_are_sites && r.prefix == last_prefix;
+                    if (!ends_share_a_site_type) {
+                        log_nonfatal_error("expected a site range such as SLICE_X0Y0:SLICE_X3Y49, found '%s' (on "
+                                           "line %d)\n",
+                                           range.c_str(), lineno);
+                        num_errors++;
+                        continue;
+                    }
+                    r.site_type = ctx->id(r.prefix);
+                    if (r.x0 > r.x1)
+                        std::swap(r.x0, r.x1);
+                    if (r.y0 > r.y1)
+                        std::swap(r.y0, r.y1);
+                    ranges.push_back(r);
+                }
+            }
+
+
+
+
+            Region *pb_region = ctx->region.at(pb->region).get();
+            int added = 0;
+            for (BelId bel : ctx->getBels()) {
+                SiteIndex si = get_bel_site(bel);
+                const auto &sites = tile_extra_data(si.tile)->sites;
+                bool bel_in_enumerated_site = si.site >= 0 && si.site < int32_t(sites.ssize());
+                if (!bel_in_enumerated_site)
+                    continue;
+                const auto &site_data = sites[si.site];
+                const IdString site_type = IdString(site_data.name_prefix);
+                for (const auto &r : ranges) {
+                    const bool site_is_in_range = site_type == r.site_type && site_data.site_x >= r.x0 &&
+                                                  site_data.site_x <= r.x1 && site_data.site_y >= r.y0 &&
+                                                  site_data.site_y <= r.y1;
+                    if (site_is_in_range) {
