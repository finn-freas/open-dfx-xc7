+static void xilinx_dsp_retime_output_ffs(Module *module)
+{
+	SigMap sigmap(module);
+	FfInitVals initvals(&sigmap, module);
+	dict<SigBit, Cell*> driver;
+	dict<SigBit, pool<Cell*>> users;
+	pool<SigBit> port_bits;
+	auto index = [&]() {
+		driver.clear();
+		users.clear();
+		port_bits.clear();
+		for (auto wire : module->wires())
+			if (wire->port_output)
+				for (auto bit : sigmap(wire))
+					port_bits.insert(bit);
+		for (auto cell : module->cells())
+			for (auto &conn : cell->connections())
+				for (auto bit : sigmap(conn.second)) {
+					if (!bit.wire)
+						continue;
+					if (cell->output(conn.first))
+						driver[bit] = cell;
+					if (cell->input(conn.first))
+						users[bit].insert(cell);
+				}
+	};
+	index();
+
+	dict<SigBit, Cell*> pbit;
+	for (auto cell : module->cells())
+		if (cell->type == ID(DSP48E1) && cell->getParam(ID(PREG)).as_int() == 0)
+			for (auto bit : sigmap(cell->getPort(ID::P)))
+				if (bit.wire)
+					pbit[bit] = cell;
+
+	std::vector<Cell*> ffs;
+	for (auto cell : module->selected_cells())
+		if (cell->type.in(ID($dff), ID($dffe)))
+			ffs.push_back(cell);
+
+	pool<Cell*> retimed;
+	for (auto cell : ffs) {
+		FfData ff(&initvals, cell);
+		if (!ff.pol_clk || !ff.val_init.is_fully_undef())
+			continue;
+		SigSpec D = sigmap(ff.sig_d);
+
+		pool<Cell*> tree;
+		std::vector<SigBit> todo(D.begin(), D.end());
+		while (!todo.empty()) {
+			SigBit bit = todo.back();
+			todo.pop_back();
+			auto it = driver.find(bit);
+			if (it == driver.end() || it->second->type != ID($add) || tree.count(it->second))
+				continue;
+			tree.insert(it->second);
+			for (auto b : sigmap(it->second->getPort(ID::A)))
+				todo.push_back(b);
+			for (auto b : sigmap(it->second->getPort(ID::B)))
+				todo.push_back(b);
+		}
+		for (bool changed = true; changed;) {
+			changed = false;
+			for (auto c : std::vector<Cell*>(tree.begin(), tree.end())) {
+				bool other = false;
+				for (auto b : sigmap(c->getPort(ID::Y))) {
+					if (port_bits.count(b))
+						other = true;
+					auto it = users.find(b);
+					if (it != users.end())
+						for (auto u : it->second)
+							if (u != cell && !tree.count(u))
+								other = true;
+				}
+				if (other) {
+					tree.erase(c);
+					changed = true;
+				}
+			}
+		}
+		if (tree.empty())
+			continue;
+
+		pool<Cell*> adders;
+		pool<SigBit> seen;
+		SigSpec leaves;
+		todo.assign(D.begin(), D.end());
+		while (!todo.empty()) {
+			SigBit bit = todo.back();
+			todo.pop_back();
+			if (!bit.wire || seen.count(bit))
+				continue;
+			seen.insert(bit);
+			auto it = driver.find(bit);
+			if (it != driver.end() && tree.count(it->second)) {
+				if (adders.insert(it->second).second) {
+					for (auto b : sigmap(it->second->getPort(ID::A)))
+						todo.push_back(b);
+					for (auto b : sigmap(it->second->getPort(ID::B)))
+						todo.push_back(b);
+				}
+			}
+			else
+				leaves.append(bit);
+		}
+		if (adders.empty() || leaves.empty())
+			continue;
+		bool ok = true;
+		dict<Cell*, SigSpec> by_dsp;
+		for (auto bit : leaves) {
+			if (!pbit.count(bit)) {
+				ok = false;
+				break;
+			}
+			by_dsp[pbit.at(bit)].append(bit);
+		}
+		if (!ok)
+			continue;
+
+		dict<SigBit, SigBit> rmap;
+		for (auto &it : by_dsp) {
+			Wire *w = module->addWire(NEW_ID, GetSize(it.second));
+			FfData nff = ff.slice({});
+			nff.sig_d = it.second;
+			nff.sig_q = w;
+			nff.width = GetSize(w);
+			nff.val_init = Const(State::Sx, nff.width);
+			for (int i = 0; i < GetSize(w); i++)
+				rmap[it.second[i]] = SigBit(w, i);
+			retimed.insert(nff.emit());
+		}
+		for (auto c : adders)
+			for (auto p : {ID::A, ID::B}) {
+				SigSpec s = sigmap(c->getPort(p));
+				s.replace(rmap);
+				c->setPort(p, s);
+			}
+		SigSpec newD = D;
+		newD.replace(rmap);
+		SigSpec Q = ff.sig_q;
+		for (auto bit : sigmap(Q))
+			driver.erase(bit);
+		ff.remove();
+		module->connect(Q, newD);
+		log("  moved register %s behind %d adder(s), onto the outputs of %d DSP48E1(s)\n", log_signal(Q), GetSize(adders), GetSize(by_dsp));
+	}
+	if (retimed.empty())
+		return;
+
+	sigmap.set(module);
+	index();
+	std::vector<Cell*> dsps;
+	for (auto cell : module->cells())
+		if (cell->type == ID(DSP48E1) && cell->getParam(ID(PREG)).as_int() == 0)
+			dsps.push_back(cell);
+	for (auto dsp : dsps) {
+		bool ok = true;
+		for (auto bit : sigmap(dsp->hasPort(ID(PCOUT)) ? dsp->getPort(ID(PCOUT)) : SigSpec()))
+			if (bit.wire && (users.count(bit) || port_bits.count(bit)))
+				ok = false;
+		SigSpec P = sigmap(dsp->getPort(ID::P));
+		dict<SigBit, int> ppos;
+		Cell *pff = nullptr;
+		for (int i = 0; i < GetSize(P); i++) {
+			if (!P[i].wire)
+				continue;
+			ppos[P[i]] = i;
+			if (port_bits.count(P[i]))
+				ok = false;
+			auto it = users.find(P[i]);
+			if (it == users.end())
+				continue;
+			for (auto u : it->second) {
+				if (!retimed.count(u) || (pff && pff != u))
+					ok = false;
+				pff = u;
+			}
+		}
+		if (!ok || !pff)
+			continue;
+		FfData ff(&initvals, pff);
+		SigSpec clk = sigmap(dsp->hasPort(ID::CLK) ? dsp->getPort(ID::CLK) : SigSpec());
+		if (GetSize(clk) == 1 && clk[0].wire && clk[0] != sigmap(ff.sig_clk[0]))
+			continue;
+		SigSpec newP = dsp->getPort(ID::P);
+		for (int i = 0; i < ff.width; i++) {
+			auto it = ppos.find(sigmap(ff.sig_d[i]));
+			if (it == ppos.end()) {
+				ok = false;
+				break;
+			}
+			newP[it->second] = ff.sig_q[i];
+		}
+		if (!ok)
+			continue;
+		ff.remove();
+		retimed.erase(pff);
+		dsp->setPort(ID::P, newP);
+		dsp->setPort(ID::CLK, ff.sig_clk);
+		dsp->setPort(ID(CEP), ff.has_ce ? (ff.pol_ce ? ff.sig_ce : module->Not(NEW_ID, ff.sig_ce)) : SigSpec(State::S1));
+		dsp->setPort(ID(RSTP), State::S0);
+		dsp->setParam(ID(PREG), 1);
+		log("  packed moved register into PREG of %s\n", dsp);
+	}
+}
+
