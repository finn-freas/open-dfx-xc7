diff --git a/common/place/placer_static.cc b/common/place/placer_static.cc
index 1c2c259a..fc1f9fb5 100644
--- a/common/place/placer_static.cc
+++ b/common/place/placer_static.cc
@@ -632,8 +632,6 @@ class StaticPlacer
         }
     }
 
-    const double target_util = 0.7;
-
     void insert_dark()
     {
         log_info("⌁ inserting dark nodes...\n");
@@ -662,10 +660,10 @@ class StaticPlacer
             const auto &g = groups.at(group);
             double util = g.concrete_area / g.total_area;
             log_info("⌁   group %s pre-spacer utilisation %.02f%% (target %.02f%%)\n", ctx->nameOf(cg.name),
-                     (util * 100.0), (target_util * 100.0));
+                     (util * 100.0), (cfg.target_util * 100.0));
             // TODO: better computation of spacer size and placement?
             int inserted_spacers = 0;
-            int spacer_count = (g.total_area * target_util - g.concrete_area) / cg.spacer_rect.area();
+            int spacer_count = (g.total_area * cfg.target_util - g.concrete_area) / cg.spacer_rect.area();
             if (spacer_count <= 0)
                 continue;
             while (inserted_spacers < spacer_count) {
@@ -969,7 +967,7 @@ class StaticPlacer
                     }
                 }
             }
-            float weight = 1.0 + 5 * std::pow(crit, 2);
+            float weight = 1.0 + double(cfg.timing_weight) * std::pow(double(crit), double(cfg.crit_exp));
             gradient += weight * (d_min - d_max);
         }
 
@@ -1677,7 +1675,10 @@ class StaticPlacer
                     float ip_overlap = 0;
                     for (int i = cfg.logic_groups; i < int(groups.size()); i++)
                         ip_overlap = std::max(ip_overlap, groups.at(i).overlap);
-                    if (ip_overlap < 0.15) {
+                    float logic_overlap = 0;
+                    for (int i = 0; i < cfg.logic_groups; i++)
+                        logic_overlap = std::max(logic_overlap, groups.at(i).overlap);
+                    if (ip_overlap < 0.15 && logic_overlap < cfg.ip_legalise_logic_overlap) {
                         legalise_step(true);
                         legalised_ip = true;
                         for (int i = cfg.logic_groups; i < int(groups.size()); i++)
@@ -1691,7 +1692,8 @@ class StaticPlacer
                         best_overlap = logic_overlap;
                         best_overlap_iter = iter;
                     }
-                    if (logic_overlap < 0.1 || (logic_overlap < 0.2 && iter > (best_overlap_iter + 50))) {
+                    if (logic_overlap < cfg.logic_overlap_stop ||
+                        (logic_overlap < 2 * cfg.logic_overlap_stop && iter > (best_overlap_iter + 50))) {
                         legalise_step(false);
                         break;
                     }
@@ -1718,6 +1720,11 @@ bool placer_static(Context *ctx, PlacerStaticCfg cfg)
 PlacerStaticCfg::PlacerStaticCfg(Context *ctx)
 {
     timing_driven = ctx->setting<bool>("timing_driven");
+    timing_weight = ctx->setting_or<float>("placerStatic/timingWeight", 5.0f);
+    crit_exp = ctx->setting_or<float>("placerStatic/critExp", 2.0f);
+    target_util = ctx->setting_or<double>("placerStatic/targetUtil", 0.7);
+    ip_legalise_logic_overlap = ctx->setting_or<float>("placerStatic/ipLegaliseLogicOverlap", 2.0f);
+    logic_overlap_stop = ctx->setting_or<float>("placerStatic/logicOverlapStop", 0.1f);
 
     hpwl_scale_x = 1;
     hpwl_scale_y = 1;
