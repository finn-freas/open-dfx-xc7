+void XC7Packer::untie_xadc_clocks(CellInfo *ci)
+{
+    for (IdString pin : {id_DCLK, id_CONVSTCLK}) {
+        const IdString inverted = ctx->idf("IS_%s_INVERTED", pin.c_str(ctx));
+        NetInfo *net = ci->getPort(pin);
+        const bool tied_by_inversion = net != nullptr && net->name == ctx->id("$PACKER_VCC_NET") &&
+                                       bool_or_default(ci->params, inverted, false);
+        if (tied_by_inversion) {
+            ci->disconnectPort(pin);
+            ci->connectPort(pin, ctx->nets.at(ctx->id("$PACKER_GND_NET")).get());
+            ci->params.erase(inverted);
+        }
+        if (bool_or_default(ci->params, inverted, false))
+            log_error("%s: %s inverted is not supported on the XADC\n", ctx->nameOf(ci), pin.c_str(ctx));
+    }
+}
