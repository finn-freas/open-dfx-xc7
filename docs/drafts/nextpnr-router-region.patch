+    void setup_route_regions()
+    {
+        for (auto &region_pair : ctx->region) {
+            const Region *region = region_pair.second.get();
+            if (!region->constr_pips && !region->constr_wires)
+                continue;
+            int idx = int(route_regions.size());
+            NPNR_ASSERT(idx < std::numeric_limits<int16_t>::max());
+            route_regions.push_back(region);
+            if (!region->constr_pips)
+                continue;
+            for (Loc l : region->piplocs) {
+                auto ins = route_region_by_tile.emplace(std::make_pair(l.x, l.y), idx);
+                if (!ins.second && ins.first->second != idx)
+                    log_error("Routing regions '%s' and '%s' share the pips of tile (%d, %d); a net cannot be held "
+                              "to both\n",
+                              ctx->nameOf(route_regions.at(ins.first->second)->name), ctx->nameOf(region->name),
+                              l.x, l.y);
+            }
+        }
+    }
+
+
+    void setup_route_region_wires()
+    {
+        for (int idx = 0; idx < int(route_regions.size()); idx++) {
+            const Region *region = route_regions.at(idx);
+            if (!region->constr_wires)
+                continue;
+            for (WireId w : region->wires) {
+                auto &wd = wire_data(w);
+                if (wd.route_region != -1 && wd.route_region != idx)
+                    log_error("Routing regions '%s' and '%s' share wire '%s'; a net cannot be held to both\n",
+                              ctx->nameOf(route_regions.at(wd.route_region)->name), ctx->nameOf(region->name),
+                              ctx->nameOfWire(w));
+                wd.route_region = int16_t(idx);
+            }
+        }
+    }
+
+    int route_region_of(const CellInfo *cell) const
+    {
+        if (cell == nullptr || cell->region == nullptr)
+            return -1;
+        for (int idx = 0; idx < int(route_regions.size()); idx++)
+            if (route_regions.at(idx) == cell->region)
+                return idx;
+        return -1;
+    }
