+                                   lineno);
+                num_errors++;
+                goto nextline;
+            }
+            std::unique_ptr<Region> pb_region(new Region());
+            pb_region->name = pb_name;
+            pb_region->constr_bels = false;
+            ctx->region[pb_name] = std::move(pb_region);
+            pblocks[pb_name].region = pb_name;
+        } else if (cmd == "add_cells_to_pblock") {
+
+
+
+
+            if (arguments.size() < 3) {
+                log_nonfatal_error("expected a pblock and cells to 'add_cells_to_pblock' (on line %d)\n", lineno);
+                num_errors++;
+                goto nextline;
