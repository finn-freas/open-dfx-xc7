+void TimingAnalyser::log_corner_summary(const std::string &corner,
+                                        dict<std::string, std::pair<delay_t, std::string>> &worst)
+{
+    build_endpoint_reports(1);
+    dict<std::pair<IdString, int>, domain_id_t> domain_of;
+    for (domain_id_t i = 0; i < domain_id_t(domains.size()); i++)
+        if (!domains.at(i).key.is_async())
+            domain_of[std::make_pair(domains.at(i).key.clock, int(domains.at(i).key.edge))] = i;
+
+    auto startpoint = [&](CellPortKey p, domain_id_t launch, bool longest) {
+        pool<CellPortKey> seen;
+        while (seen.insert(p).second) {
+            auto &pd = ports.at(p);
+            auto a = pd.arrival.find(launch);
+            if (a == pd.arrival.end())
+                break;
+            CellPortKey prev = longest ? a->second.bwd_max : a->second.bwd_min;
+            if (prev.cell == IdString())
+                break;
+            p = prev;
+        }
+        return p;
+    };
+    struct Worst
+    {
+        int count = 0, failing = 0;
+        delay_t slack = 0;
+        std::string at;
+    };
+    std::map<std::string, Worst> lines;
+    for (auto &check : result.endpoint_checks) {
+        if (!check.untimed.empty())
+            continue;
+        CellPortKey ep(check.cell_port.first, check.cell_port.second);
+        auto launch = domain_of.find(std::make_pair(check.clock_pair.start.clock, int(check.clock_pair.start.edge)));
+        for (const bool is_setup : {true, false}) {
+            if (!(is_setup ? check.has_setup : check.has_hold))
+                continue;
+            std::string kind = "reg";
+            if (io_ends.count(ep))
+                kind = "out";
+            else if (launch != domain_of.end() && io_starts.count(startpoint(ep, launch->second, is_setup)))
+                kind = "in ";
+            const delay_t slack = is_setup ? check.setup_slack : check.hold_slack;
+            auto &w = lines[std::string(is_setup ? "setup" : "hold ") + " " + kind];
+            if (w.count == 0 || slack < w.slack) {
+                w.slack = slack;
+                w.at = stringf("%s.%s", ep.cell.c_str(ctx), ep.port.c_str(ctx));
+            }
+            w.count++;
+            if (slack < 0)
+                w.failing++;
+        }
+    }
+    for (auto &l : lines) {
+        log_info("corner %-4s %s: worst slack %7.3f ns at %s (%d endpoint checks, %d failing)\n", corner.c_str(),
+                 l.first.c_str(), ctx->getDelayNS(l.second.slack), l.second.at.c_str(), l.second.count,
+                 l.second.failing);
+        auto found = worst.find(l.first);
+        if (found == worst.end() || l.second.slack < found->second.first)
+            worst[l.first] = std::make_pair(l.second.slack, corner);
+    }
+}
+
+void log_timing_corners(Context *ctx)
+{
+    const int corners = ctx->getTimingCornerCount();
+    if (corners == 0)
+        return;
+    log_break();
+    log_info("Timing at each process corner (-o timing-corners; report only, placement and routing use the default "
+             "delays):\n");
+    dict<std::string, std::pair<delay_t, std::string>> worst;
+    for (int c = 1; c <= corners; c++) {
+        ctx->setTimingCorner(c);
+        TimingAnalyser tmg(ctx);
+        tmg.setup_only = false;
+        tmg.with_clock_skew = true;
+        tmg.setup(false, false, false);
+        tmg.log_corner_summary(ctx->getTimingCornerName(c), worst);
+    }
+    ctx->setTimingCorner(0);
+    std::vector<std::string> keys;
+    for (auto &w : worst)
+        keys.push_back(w.first);
+    std::sort(keys.begin(), keys.end());
+    for (auto &k : keys)
+        log_info("all corners %s: worst slack %7.3f ns (corner %s)\n", k.c_str(), ctx->getDelayNS(worst.at(k).first),
+                 worst.at(k).second.c_str());
+    log_break();
+}
