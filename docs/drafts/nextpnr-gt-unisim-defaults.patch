From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Sun, 8 Nov 2026 08:56:10 -0500
Subject: [PATCH] xilinx: -o gt-unisim-defaults: UNISIM defaults for GTPE2 and
 PCIE_2_1 parameters in the FASM writer

yosys passes only the parameters an instance sets.  For every other
GTPE2_CHANNEL, GTPE2_COMMON and PCIE_2_1 parameter the writer used its own
default, and 120 of them differ from the UNISIM default (PCIE_2_1
PL_FAST_TRAIN TRUE, the simulation-only training timers; GTPE2_COMMON
PLL0/1_FBDIV; GTPE2_CHANNEL RX_DATA_WIDTH, PMA_RSV, ...).  With the option,
a parameter the netlist leaves out gets its UNISIM default
(gt_unisim_defaults.h, generated from yosys cells_xtra.v) while the cell is
written, and the PCIE_2_1 SPARE_BIT/BYTE/WORD attributes, which have bits in
the database, are written.  Off by default: the FASM is unchanged.
---
 himbaechel/uarch/xilinx/fasm.cc              |  47 ++
 himbaechel/uarch/xilinx/gt_unisim_defaults.h | 577 +++++++++++++++++++
 himbaechel/uarch/xilinx/xilinx.cc            |   4 +
 3 files changed, 628 insertions(+)
 create mode 100644 himbaechel/uarch/xilinx/gt_unisim_defaults.h

diff --git a/himbaechel/uarch/xilinx/fasm.cc b/himbaechel/uarch/xilinx/fasm.cc
index 8ab52d2b..965d5c63 100644
--- a/himbaechel/uarch/xilinx/fasm.cc
+++ b/himbaechel/uarch/xilinx/fasm.cc
@@ -28,6 +28,7 @@
 #include <system_error>
 
 #include "extra_data.h"
+#include "gt_unisim_defaults.h"
 #include "himbaechel_api.h"
 #include "log.h"
 #include "nextpnr.h"
@@ -5294,6 +5295,18 @@ struct FasmBackend
 
         write_str_bool("PL_FAST_TRAIN", "TRUE");
 
+        if (gt_unisim) {
+            for (int i = 0; i <= 8; i++)
+                write_int_vector(stringf("SPARE_BIT%d[0:0]", i),
+                                 int_or_default(ci->params, ctx->id(stringf("SPARE_BIT%d", i)), 0), 1);
+            for (int i = 0; i <= 3; i++)
+                write_int_vector(stringf("SPARE_BYTE%d[7:0]", i),
+                                 int_or_default(ci->params, ctx->id(stringf("SPARE_BYTE%d", i)), 0), 8);
+            for (int i = 0; i <= 3; i++)
+                write_int_vector(stringf("SPARE_WORD%d[31:0]", i),
+                                 int_or_default(ci->params, ctx->id(stringf("SPARE_WORD%d", i)), 0), 32);
+        }
+
         auto pm_aspml0s_timeout = int_or_default(ci->params, ctx->id("PM_ASPML0S_TIMEOUT"), 0x0);
         write_int_vector("PM_ASPML0S_TIMEOUT[14:0]", pm_aspml0s_timeout, 15);
 
@@ -5588,10 +5601,44 @@ struct FasmBackend
         pop(); // tile name
     }
 
+
+
+
+    bool gt_unisim = false;
+
+    const char *gt_unisim_prim(const CellInfo *ci) const
+    {
+        if (ci->type == id_GTPE2_CHANNEL)
+            return "GTPE2_CHANNEL";
+        if (ci->type == id_GTPE2_COMMON)
+            return "GTPE2_COMMON";
+        if (ci->type == id_PCIE_2_1_PCIE_2_1)
+            return "PCIE_2_1";
+        return nullptr;
+    }
+
     void write_ip()
     {
+        gt_unisim = ctx->args.options.count("gt-unisim-defaults");
         for (auto &cell : ctx->cells) {
             CellInfo *ci = cell.second.get();
+            const char *prim = gt_unisim ? gt_unisim_prim(ci) : nullptr;
+            dict<IdString, Property> saved;
+            if (prim) {
+                saved = ci->params;
+                for (const auto &d : gt_unisim_defaults)
+                    if (!strcmp(d.prim, prim) && !ci->params.count(ctx->id(d.name)))
+                        ci->params[ctx->id(d.name)] = Property::from_string(d.value);
+            }
+            write_ip_cell(ci);
+            if (prim)
+                ci->params = saved;
+        }
+    }
+
+    void write_ip_cell(CellInfo *ci)
+    {
+        {
             bool is_placed = ci->bel != BelId();
             if (ci->type == id_DSP48E1_DSP48E1) {
                 write_dsp_cell(ci);
