From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Finn Freas <finn.freas@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] placer: opt-in placement options for the static placer and
 placer1

- Context::setting_or reads a setting without interning its name.
- --tmg-crit-target/--tmg-crit-floor: criticality from the slack
  against a fraction of the clock period.
- --placer-static-{timingweight,critexp,target-util,ip-wait,overlap-stop}
- --placer1-{critexp,timing-tradeoff}
- xilinx: -o static-hpwl-x=N, -o static-ff-area=A

Every option is off by default and an unset option changes nothing.
---
 common/kernel/command.cc          | 40 +++++++++++++++++++++++++++++++
 common/kernel/context.h           | 12 ++++++++++
 common/kernel/timing.cc           | 18 +++++++++++---
 common/kernel/timing.h            |  3 +++
 common/place/placer1.cc           |  4 ++++
 common/place/placer1.h            |  1 +
 common/place/placer_static.cc     | 21 ++++++++++------
 common/place/placer_static.h      |  4 ++++
 himbaechel/uarch/xilinx/xilinx.cc | 15 ++++++++++--
 9 files changed, 106 insertions(+), 12 deletions(-)

diff --git a/common/kernel/command.cc b/common/kernel/command.cc
index 16a34b61..6759ae12 100644
--- a/common/kernel/command.cc
+++ b/common/kernel/command.cc
@@ -385,6 +385,28 @@ po::options_description CommandHandler::getGeneralOptions()
     general.add_options()("placer-heap-no-ctrl-set", "disable control set awareness in placer heap");
 
     general.add_options()("static-dump-density", "write density csv files during placer-static flow");
+    general.add_options()("placer-static-timingweight", po::value<float>(),
+                          "placer static: net weight of an arc is 1 + W * criticality ^ E (float W, default: 5)");
+    general.add_options()("placer-static-critexp", po::value<float>(),
+                          "placer static: criticality exponent E of the arc weight (float, default: 2)");
+    general.add_options()("placer-static-target-util", po::value<double>(),
+                          "placer static: total area of cells and fillers as a fraction of the device (default: 0.7)");
+    general.add_options()("placer-static-ip-wait", po::value<float>(),
+                          "placer static: legalise block RAMs and DSPs only once the logic overlap is below this "
+                          "fraction, so their sites follow the logic (float, default: off)");
+    general.add_options()("placer-static-overlap-stop", po::value<float>(),
+                          "placer static: stop spreading and legalise the logic once its overlap is below this "
+                          "fraction (float, default: 0.1)");
+    general.add_options()("placer1-critexp", po::value<float>(),
+                          "placer1 and placement refinement: criticality exponent of the timing cost (float, default: 8)");
+    general.add_options()("placer1-timing-tradeoff", po::value<float>(),
+                          "placer1 and placement refinement: weight of timing against wirelength, 0..1 (default: 0.5)");
+    general.add_options()("tmg-crit-target", po::value<float>(),
+                          "criticality from the slack against F times each clock's constraint instead of from the "
+                          "delay relative to the worst path (float F, e.g. 1.0; default: off)");
+    general.add_options()("tmg-crit-floor", po::value<float>(),
+                          "with --tmg-crit-target: criticality of a path that just meets the target; failing "
+                          "paths are spread over [floor, 1] (float, default: 0.9)");
 
 #if !defined(NPNR_DISABLE_THREADS)
     general.add_options()("parallel-refine", "use new experimental parallelised engine for placement refinement");
@@ -609,6 +631,24 @@ void CommandHandler::setupContext(Context *ctx)
 
     if (vm.count("static-dump-density"))
         ctx->settings[ctx->id("static/dump_density")] = true;
+    if (vm.count("placer-static-timingweight"))
+        ctx->settings[ctx->id("placerStatic/timingWeight")] = std::to_string(vm["placer-static-timingweight"].as<float>());
+    if (vm.count("placer-static-critexp"))
+        ctx->settings[ctx->id("placerStatic/critExp")] = std::to_string(vm["placer-static-critexp"].as<float>());
+    if (vm.count("placer-static-target-util"))
+        ctx->settings[ctx->id("placerStatic/targetUtil")] = std::to_string(vm["placer-static-target-util"].as<double>());
+    if (vm.count("placer-static-ip-wait"))
+        ctx->settings[ctx->id("placerStatic/ipLegaliseLogicOverlap")] = std::to_string(vm["placer-static-ip-wait"].as<float>());
+    if (vm.count("placer-static-overlap-stop"))
+        ctx->settings[ctx->id("placerStatic/logicOverlapStop")] = std::to_string(vm["placer-static-overlap-stop"].as<float>());
+    if (vm.count("placer1-critexp"))
+        ctx->settings[ctx->id("placer1/critExp")] = std::to_string(vm["placer1-critexp"].as<float>());
+    if (vm.count("placer1-timing-tradeoff"))
+        ctx->settings[ctx->id("placer1/timingTradeoff")] = std::to_string(vm["placer1-timing-tradeoff"].as<float>());
+    if (vm.count("tmg-crit-target"))
+        ctx->settings[ctx->id("timing/critTarget")] = std::to_string(vm["tmg-crit-target"].as<float>());
+    if (vm.count("tmg-crit-floor"))
+        ctx->settings[ctx->id("timing/critFloor")] = std::to_string(vm["tmg-crit-floor"].as<float>());
 
     // Setting default values
     if (ctx->settings.find(ctx->id("target_freq")) == ctx->settings.end())
diff --git a/common/kernel/context.h b/common/kernel/context.h
index 473d9b21..e7cb3179 100644
--- a/common/kernel/context.h
+++ b/common/kernel/context.h
@@ -121,6 +121,18 @@ struct Context : Arch, DeterministicRNG
         return defaultValue;
     }
 
+    template <typename T> T setting_or(const char *name, T defaultValue) const
+    {
+        auto known = idstring_str_to_idx->find(name);
+        if (known == idstring_str_to_idx->end())
+            return defaultValue;
+        auto found = settings.find(IdString(known->second));
+        if (found == settings.end())
+            return defaultValue;
+        return boost::lexical_cast<T>(found->second.is_string ? found->second.as_string()
+                                                              : std::to_string(found->second.as_int64()));
+    }
+
     template <typename T> T setting(const char *name) const
     {
         IdString new_id = id(name);
diff --git a/common/kernel/timing.cc b/common/kernel/timing.cc
index 17e48833..39ad26b0 100644
--- a/common/kernel/timing.cc
+++ b/common/kernel/timing.cc
@@ -161,6 +161,8 @@ TimingAnalyser::TimingAnalyser(Context *ctx) : ctx(ctx)
         auto clock_skew = ctx->settings.find(IdString(known->second));
         with_clock_skew = clock_skew != ctx->settings.end() && clock_skew->second.as_bool();
     }
+    crit_target = ctx->setting_or<float>("timing/critTarget", 0.0f);
+    crit_floor = ctx->setting_or<float>("timing/critFloor", 0.9f);
     ClockDomainKey key{IdString(), ClockEdge::RISING_EDGE};
     domain_to_id.emplace(key, 0);
     domains.emplace_back(key);
@@ -1005,12 +1007,22 @@ void TimingAnalyser::compute_criticality()
                 ctx->timing_exceptions.at(dp.setup_exception).kind == TimingException::FALSE_PATH)
                 continue;
 
-            float crit =
-                    1.0f - (float(pdp.second.setup_slack) - float(dp.worst_setup_slack)) / float(-dp.worst_setup_slack);
-
+            float crit;
+            delay_t budget = delay_t(float(dp.period.minDelay()) * crit_target);
             if (dp.setup_exception >= 0) {
+
                 float requirement = float(dp.period.minDelay());
                 crit = requirement > 0 ? float(-pdp.second.setup_slack) / requirement : 1.0f;
+            } else if (budget > 0) {
+                float slack = float(budget + pdp.second.setup_slack);
+                float worst = float(budget + dp.worst_setup_slack);
+                if (slack < 0)
+                    crit = crit_floor + (1.0f - crit_floor) * slack / worst;
+                else
+                    crit = crit_floor * (1.0f - slack / float(budget));
+            } else {
+                crit = 1.0f -
+                       (float(pdp.second.setup_slack) - float(dp.worst_setup_slack)) / float(-dp.worst_setup_slack);
             }
             crit = std::min(crit, 1.0f);
             crit = std::max(crit, 0.0f);
diff --git a/common/kernel/timing.h b/common/kernel/timing.h
index ca36e815..561f042a 100644
--- a/common/kernel/timing.h
+++ b/common/kernel/timing.h
@@ -110,6 +110,9 @@ struct TimingAnalyser
     // Enable analysis of clock skew between FFs.
     bool with_clock_skew = false;
 
+    float crit_target = 0;
+    float crit_floor = 0.9f;
+
     bool setup_only = false;
     bool have_loops = false;
     bool updated_domains = false;
diff --git a/common/place/placer1.cc b/common/place/placer1.cc
