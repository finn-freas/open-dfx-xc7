+                            lineno);
+            pb_region->constr_bels = !pb_region->bels.empty();
+            log_info("resize_pblock: pblock '%s' has %d bel(s) (on line %d)\n", pb->region.c_str(ctx),
+                     int(pb_region->bels.size()), lineno);
         } else {
             log_warning("ignoring unsupported XDC command '%s' (on line %d)\n", cmd.c_str(), lineno);
         }
@@ -541,6 +790,167 @@ void XilinxImpl::parse_xdc(const std::string &filename)
     if (num_errors > 0) {
         log_error("Stopping the program after %u errors found in XDC file\n", num_errors);
     }
