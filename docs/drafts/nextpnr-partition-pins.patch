+void XilinxImpl::apply_partition_pins()
+{
+    int given = 0, not_in_design = 0, unused = 0;
+    for (auto &pp : partition_pin_wires) {
+        auto it = ctx->nets.find(pp.first);
+        const bool this_design_has_no_such_net = (it == ctx->nets.end());
+        if (this_design_has_no_such_net) {
+            if (not_in_design < 10)
+                log_info("Partition pin: net '%s' is not in this design\n", pp.first.c_str(ctx));
+            not_in_design++;
+            continue;
+        }
+        NetInfo *ni = it->second.get();
+        auto contains_routing = [](const CellInfo *ci) {
+            return ci != nullptr && ci->region != nullptr && ci->region->constr_pips;
+        };
+        Region *r = nullptr;
+        if (contains_routing(ni->driver.cell))
+            r = ni->driver.cell->region;
+        else
+            for (auto &usr : ni->users)
+                if (contains_routing(usr.cell)) {
+                    r = usr.cell->region;
+                    break;
+                }
+
+
+
+
+        const bool net_touches_no_contained_pblock = (r == nullptr);
+        if (net_touches_no_contained_pblock) {
+            auto pblock_of_pip = [&](PipId pip) -> Region * {
+                Loc l = ctx->getPipLocation(pip);
+                for (auto &region : ctx->region)
+                    if (region.second->constr_pips && region.second->piplocs.count(Loc(l.x, l.y, 0)))
+                        return region.second.get();
+                return nullptr;
+            };
+            for (PipId pip : ctx->getPipsDownhill(pp.second))
+                if ((r = pblock_of_pip(pip)) != nullptr)
+                    break;
+            if (r == nullptr)
+                for (PipId pip : ctx->getPipsUphill(pp.second))
+                    if ((r = pblock_of_pip(pip)) != nullptr)
+                        break;
+            if (r == nullptr)
+                log_error("Partition pin %s of net '%s' reaches no pblock that contains its routing\n",
+                          ctx->nameOfWire(pp.second), pp.first.c_str(ctx));
+            unused++;
+        }
+        NetInfo *bound = ctx->getBoundWireNet(pp.second);
+        const bool pin_is_someone_elses = (bound != nullptr && bound != ni);
+        if (pin_is_someone_elses)
+            log_error("Partition pin %s of net '%s' is bound to net '%s'\n", ctx->nameOfWire(pp.second),
+                      pp.first.c_str(ctx), bound->name.c_str(ctx));
+        r->partition_pins[ni->name] = pp.second;
+        if (!net_touches_no_contained_pblock)
+            given++;
+    }
+    const bool some_pins_were_given = (given + not_in_design + unused) != 0;
+    if (some_pins_were_given)
+        log_info("Partition pins: %d given to their pblocks, %d on nets that no longer enter or leave a pblock "
+                 "(locked route up to the pin kept), %d not in this design.\n",
+                 given, unused, not_in_design);
