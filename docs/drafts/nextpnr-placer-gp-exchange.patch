+    void gp_import(const std::string &path)
+    {
+        std::ifstream in(path);
+        if (!in)
+            log_error("cannot read %s\n", path.c_str());
+        dict<IdString, RealPair> want;
+        std::string name;
+        float x, y;
+        while (in >> name >> x >> y)
+            want[ctx->id(name)] = RealPair(x, y);
+        int got = 0, miss = 0;
+        for (int i = 0; i < int(ccells.size()); i++) {
+            auto &mc = mcells.at(i);
+            if (mc.is_fixed)
+                continue;
+            auto fnd = want.find(ccells.at(i).base_cell->name);
+            if (fnd == want.end()) {
+                miss++;
+                continue;
+            }
+            mc.pos = mc.ref_pos = clamp_loc(fnd->second);
+            got++;
+        }
+        for (auto &m : macros) {
+            RealPair anchor(0, 0);
+            int n = 0;
+            for (int idx : m.conc_cells) {
+                auto &cc = ccells.at(idx);
+                anchor += mcells.at(idx).pos - RealPair(float(cc.chunk_dx), float(cc.chunk_dy));
+                n++;
+            }
+            if (n == 0)
+                continue;
+            anchor /= float(n);
+            for (int idx : m.conc_cells) {
+                auto &cc = ccells.at(idx);
+                if (mcells.at(idx).is_fixed)
+                    continue;
+                mcells.at(idx).pos = mcells.at(idx).ref_pos = clamp_loc(anchor + RealPair(float(cc.chunk_dx), float(cc.chunk_dy)));
+            }
+        }
+        log_info("Imported the global placement of %d cells from %s (%d movable cells not in the file).\n", got,
+                 path.c_str(), miss);
+    }
