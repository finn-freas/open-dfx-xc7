+void TimingAnalyser::build_endpoint_reports(int paths_per_pair)
+{
+    auto &checks = result.endpoint_checks;
+    checks.clear();
+    result.reported_paths.clear();
+    result.clock_nets.clear();
+    for (auto &dom : domains)
+        if (!dom.key.is_async() &&
+            std::find(result.clock_nets.begin(), result.clock_nets.end(), dom.key.clock) == result.clock_nets.end())
+            result.clock_nets.push_back(dom.key.clock);
+
+    struct Candidate
+    {
+        delay_t slack, requirement;
+        domain_id_t pair;
+        CellPortKey endpoint;
+        std::string exception;
+    };
+    dict<ClockPair, std::vector<Candidate>> setup_candidates, hold_candidates;
+    dict<domain_id_t, bool> related;
+
+    for (domain_id_t capture_id = 0; capture_id < domain_id_t(domains.size()); ++capture_id) {
+        const ClockDomainKey &capture = domains.at(capture_id).key;
+        for (auto &ep : domains.at(capture_id).endpoints) {
+            auto &pd = ports.at(ep.first);
+            auto req = pd.required.find(capture_id);
+            if (req == pd.required.end())
+                continue;
+            int clk_count = 0;
+            const bool register_end =
+                    ctx->getPortTimingClass(cell_info(ep.first), ep.first.port, clk_count) == TMG_REGISTER_INPUT;
+            if (pd.arrival.empty()) {
+
+                const NetInfo *net = port_info(ep.first).net;
+                const bool constant = net == nullptr || net->driver.cell == nullptr ||
+                                      net->constant_value != IdString() || net->name.str(ctx).rfind("$PACKER_", 0) == 0;
+                if (!constant) {
+                    TimingResult::EndpointCheck check;
+                    check.clock_pair.start.clock = IdString();
+                    check.clock_pair.start.edge = RISING_EDGE;
+                    check.clock_pair.end.clock = capture.clock;
+                    check.clock_pair.end.edge = capture.edge;
+                    check.cell_port = std::make_pair(ep.first.cell, ep.first.port);
+                    check.untimed = capture.is_async() ? "no clock" : "no launch clock";
+                    checks.push_back(check);
+                }
+            }
+            for (auto &arr : pd.arrival) {
+                const domain_id_t launch_id = arr.first;
+                const ClockDomainKey &launch = domains.at(launch_id).key;
+                auto found_pair = pair_to_id.find(ClockDomainPairKey(launch_id, capture_id));
+                if (found_pair == pair_to_id.end())
+                    continue;
+                const domain_id_t pair_id = found_pair->second;
+                auto pdp = pd.domain_pairs.find(pair_id);
+                if (pdp == pd.domain_pairs.end())
+                    continue;
+                const PerDomainPair &dp = domain_pairs.at(pair_id);
+
+                TimingResult::EndpointCheck check;
+                check.clock_pair.start.clock = launch.clock;
+                check.clock_pair.start.edge = launch.edge;
+                check.clock_pair.end.clock = capture.clock;
+                check.clock_pair.end.edge = capture.edge;
+                check.cell_port = std::make_pair(ep.first.cell, ep.first.port);
+                check.arrival = arr.second.value;
+                const TimingException *setup_ex =
+                        dp.setup_exception >= 0 ? &ctx->timing_exceptions.at(dp.setup_exception) : nullptr;
+                if (setup_ex != nullptr)
+                    check.exception = setup_ex->name;
+
+                if (launch.is_async() && capture.is_async())
+                    check.untimed = "no clock";
+                else if (launch.is_async())
+                    check.untimed = "no launch clock";
+                else if (capture.is_async())
+                    check.untimed = "no capture clock";
+                else if (is_false_clock_pair(ctx, launch.clock, capture.clock))
+                    check.untimed = "false path between the clocks";
+                else if (setup_ex != nullptr && setup_ex->kind == TimingException::FALSE_PATH)
+                    check.untimed = "false path";
+                else if (launch.clock != capture.clock && setup_ex == nullptr) {
+                    auto rel = related.find(pair_id);
+                    if (rel == related.end()) {
+                        delay_t relationship;
+                        rel = related
+                                      .emplace(pair_id, clock_setup_relationship(ctx, launch.clock, launch.edge,
+                                                                                 capture.clock, capture.edge,
+                                                                                 relationship))
+                                      .first;
+                    }
+                    if (!rel->second)
+                        check.untimed = "unrelated clocks";
+                }
+
+                if (check.untimed.empty()) {
+                    check.has_setup = true;
+                    check.setup_requirement = dp.period.minDelay();
+                    int mcp = setup_multicycle(ctx, ep.first.cell, capture.clock);
+                    if (mcp > 1)
+                        check.setup_requirement += ctx->nets.at(capture.clock)->clkconstr->period.minDelay() * (mcp - 1);
+                    check.setup_slack = dp.period.minDelay() + pdp->second.setup_slack;
+                    setup_candidates[check.clock_pair].push_back(
+                            Candidate{check.setup_slack, check.setup_requirement, pair_id, ep.first, check.exception});
+                }
+
+                auto clocks = std::make_pair(launch.clock, capture.clock);
+                const bool related_clocks = clock_delays.count(clocks) > 0;
+                const bool one_clock = launch.clock == capture.clock && launch.edge == capture.edge;
+                const bool hold_endpoint = register_end || io_ends.count(ep.first);
+                bool has_hold = !setup_only && hold_endpoint && !launch.is_async() && !capture.is_async() &&
+                                (one_clock || related_clocks || dp.has_hold_relationship) &&
+                                !is_false_clock_pair(ctx, launch.clock, capture.clock);
+                delay_t hold_requirement = dp.hold_relationship;
+                std::string hold_exception;
+                if (has_hold && dp.hold_exception >= 0) {
+                    const TimingException &ex = ctx->timing_exceptions.at(dp.hold_exception);
+                    has_hold = ex.kind == TimingException::MIN_DELAY;
+                    hold_requirement = ex.value;
+                    hold_exception = ex.name;
+                } else {
+                    hold_requirement += clock_uncertainty(ctx, launch.clock, capture.clock, false);
+                }
+                if (has_hold) {
+                    delay_t clock_to_clock = related_clocks ? clock_delays.at(clocks) : 0;
+                    check.has_hold = true;
+                    check.hold_requirement = hold_requirement;
+                    check.hold_slack = arr.second.value.minDelay() - req->second.value.maxDelay() + clock_to_clock -
+                                       hold_requirement;
+                    hold_candidates[check.clock_pair].push_back(
+                            Candidate{check.hold_slack, check.hold_requirement, pair_id, ep.first, hold_exception});
+                }
+                checks.push_back(check);
+            }
+        }
+    }
+
+    auto add_worst = [&](dict<ClockPair, std::vector<Candidate>> &candidates, bool is_hold) {
+        for (auto &group : candidates) {
+            auto &list = group.second;
+            std::stable_sort(list.begin(), list.end(),
+                             [](const Candidate &a, const Candidate &b) { return a.slack < b.slack; });
+            int taken = 0;
+            for (auto &c : list) {
+                if (taken >= paths_per_pair)
+                    break;
+                if (walk_crit_path(c.pair, c.endpoint, !is_hold).empty())
+                    continue;
+                TimingResult::ReportedPath path;
+                path.is_hold = is_hold;
+                path.slack = c.slack;
+                path.exception = c.exception;
+                path.endpoint = std::make_pair(c.endpoint.cell, c.endpoint.port);
+                path.path = build_critical_path_report(c.pair, c.endpoint, !is_hold);
+                path.requirement = c.requirement;
+                result.reported_paths.push_back(path);
+                taken++;
+            }
+        }
+    };
+    add_worst(setup_candidates, false);
+    add_worst(hold_candidates, true);
+}
+
 // set_input_delay and set_output_delay, as the XDC reader leaves them on the port's cell:
 // NEXTPNR_INPUT_DELAY / NEXTPNR_OUTPUT_DELAY = "<clock> <0 rising | 1 falling> <min ns> <max ns>"
 void TimingAnalyser::setup_io_delays()
@@ -2030,6 +2194,8 @@ void timing_analysis(Context *ctx, bool print_slack_histogram, bool print_fmax,
     tmg.setup_only = false;
     tmg.with_clock_skew = true;
     tmg.setup(ctx->detailed_timing_report, print_slack_histogram, print_path || print_fmax);
+    if (update_results && ctx->timing_report_paths > 0)
+        tmg.build_endpoint_reports(ctx->timing_report_paths);
 
     auto &result = tmg.get_timing_result();
     ctx->log_timing_results(result, print_slack_histogram, print_fmax, print_path, warn_on_failure);
