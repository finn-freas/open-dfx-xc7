+bool XilinxImpl::getCellDelay(const CellInfo *cell, IdString fromPort, IdString toPort, DelayQuad &delay) const
+{
+    if (HimbaechelAPI::getCellDelay(cell, fromPort, toPort, delay))
+        return true;
+
+    const bool is_bufg_arc = cell->type == id_BUFGCTRL && fromPort.in(id_I0, id_I1) && toPort == id_O;
+    if (is_bufg_arc) {
+        delay = DelayQuad(ctx->getDelayFromNS(0.026), ctx->getDelayFromNS(0.096));
+        return true;
+    }
+    const std::string type = cell->type.str(ctx);
+    const bool is_input = boost::contains(type, "INBUF") && toPort == id_OUT;
+    const bool is_output = boost::contains(type, "OUTBUF") && fromPort == id_IN && toPort == id_OUT;
+    if (!is_input && !is_output)
+        return false;
+    const CellInfo *pad = nullptr;
+    for (auto &port : cell->ports) {
+        const NetInfo *ni = port.second.net;
+        if (ni == nullptr)
+            continue;
+        for (auto &usr : ni->users)
+            if (usr.cell->type == id_PAD)
+                pad = usr.cell;
+    }
+    if (pad == nullptr)
+        return false;
+    static const dict<std::string, double> input_ns = {{"LVCMOS33", 1.489}};
+    static const dict<std::string, double> output_ns = {{"LVCMOS33/12/SLOW", 3.569}};
+    std::string key = str_or_default(pad->attrs, id_IOSTANDARD, "");
+    if (is_output)
+        key += "/" + str_or_default(pad->attrs, id_DRIVE, "12") + "/" + str_or_default(pad->attrs, id_SLEW, "SLOW");
+    const auto &table = is_input ? input_ns : output_ns;
+    auto found = table.find(key);
+    if (found == table.end()) {
+        if (warned_pad_buffers.insert(key).second)
+            log_warning("no %s buffer delay is known for %s; port paths through it are timed without one\n",
+                        is_input ? "input" : "output", key.c_str());
+        return false;
+    }
+    delay = DelayQuad(ctx->getDelayFromNS(found->second));
+    return true;
+}
