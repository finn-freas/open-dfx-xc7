+            const int width = int_or_default(ci->params, ctx->id("DATA_WIDTH"), 4);
+            const bool odd_width = width == 1 || width == 9;
+            for (const char *w : {"READ_WIDTH_A", "READ_WIDTH_B", "WRITE_WIDTH_A", "WRITE_WIDTH_B"})
+                write_bit(std::string("RAMB36.BRAM36_") + w + "_1", odd_width);
+        }
+    }
