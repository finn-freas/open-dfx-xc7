+    void check_region_routing()
+    {
+        if (route_regions.empty())
+            return;
+        int held = 0, crossing = 0, locked_breaking = 0;
+        for (auto net : nets_by_udata) {
+            auto &nd = nets.at(net->udata);
+            for (auto usr : net->users.enumerate()) {
+                for (size_t j = 0; j < nd.arcs.at(usr.index.idx()).size(); j++) {
+                    auto &ad = nd.arcs.at(usr.index.idx()).at(j);
+                    if (ad.contain_region != -1)
+                        ++held;
+                    else if (ad.driver_region != ad.sink_region)
+                        ++crossing;
+
+
+                    const bool arc_is_locked_outside_its_region = ad.contain_region != -1 && ad.pre_routed &&
+                                                                  arc_route_breaks_region(net, usr.index, j) &&
+                                                                  arc_route_is_locked(net, usr.index, j);
+                    if (arc_is_locked_outside_its_region) {
+                        if (locked_breaking < 10)
+                            log_warning("Arc %d.%d of net '%s' is locked to a route that breaks its routing region; "
+                                        "it is left as it is\n",
+                                        usr.index.idx(), int(j), ctx->nameOf(net));
+                        ++locked_breaking;
+                    }
+                }
+            }
+        }
+        log_info("Routing regions: %d region(s); %d arc(s) held inside one, %d arc(s) cross a region edge and are "
+                 "not held%s\n",
+                 int(route_regions.size()), held, crossing,
+                 cfg.region_keep_out ? "; other arcs are kept out of the regions" : "");
+        if (locked_breaking > 0)
+            log_warning("%d locked arc(s) break their routing region\n", locked_breaking);
+    }
