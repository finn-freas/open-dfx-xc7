     // Strict placement legalisation, performed after the initial HeAP spreading
+
+
+
+
+
+    bool legalise_ring(CellInfo *ci)
+    {
+        FastBels::FastBelsData *fb;
+        fast_bels.getBelsForCellType(ci->type, &fb);
+        auto &mc = mcells.at(ci->udata);
+        float px = std::max(0.0f, std::min(float(width - 1), mc.pos.x)), py = std::max(0.0f, std::min(float(height - 1), mc.pos.y));
+        int cx = place_x_to_bel_x.at(int(px)), cy = place_y_to_bel_y.at(int(py));
+
+        std::vector<Loc> nb;
+        for (auto &port : ci->ports) {
+            NetInfo *ni = port.second.net;
+            if (!ni || ni->driver.cell == nullptr || ni->users.entries() > 16)
+                continue;
+            auto add = [&](CellInfo *o) {
+                if (o != ci && o->bel != BelId())
+                    nb.push_back(ctx->getBelLocation(o->bel));
+            };
+            add(ni->driver.cell);
+            for (auto &u : ni->users)
+                add(u.cell);
+        }
+        const float wy = cfg.legal_wy, wn = nb.empty() ? 0.0f : cfg.legal_wn / float(nb.size());
+        float best = std::numeric_limits<float>::max();
+        BelId best_bel;
+        for (int r = 0; r <= cfg.legal_ring; r++) {
+
+            if (best_bel != BelId() && float(r) * std::min(1.0f, wy) > best)
+                break;
+            for (int y = cy - r; y <= cy + r; y++) {
+                for (int x = cx - r; x <= cx + r; x++) {
+                    if (std::max(std::abs(x - cx), std::abs(y - cy)) != r)
+                        continue;
+                    if (x < 0 || y < 0 || x >= int(fb->size()) || y >= int(fb->at(x).size()))
+                        continue;
+                    float disp = std::abs(x - cx) + wy * std::abs(y - cy);
+                    if (disp >= best)
+                        continue;
+                    float wl = 0;
+                    for (auto &l : nb)
+                        wl += std::abs(l.x - x) + wy * std::abs(l.y - y);
+                    float cost = disp + wn * wl;
+                    if (cost >= best)
+                        continue;
+                    for (auto bel : fb->at(x).at(y)) {
+                        if (ci->cluster != ClusterId()) {
+
+
+                            std::vector<std::pair<CellInfo *, BelId>> targets;
+                            if (!ctx->getClusterPlacement(ci->cluster, bel, targets))
+                                continue;
+                            bool free = true;
+                            for (auto &t : targets)
+                                if (!t.first->testRegion(t.second) || !ctx->checkBelAvail(t.second))
+                                    free = false;
+                            if (!free)
+                                continue;
+                            for (auto &t : targets)
+                                ctx->bindBel(t.second, t.first, STRENGTH_STRONG);
+                            bool ok = true;
+                            for (auto &t : targets)
+                                ok = ok && ctx->isBelLocationValid(t.second);
+                            for (auto &t : targets)
+                                ctx->unbindBel(t.second);
+                            if (ok) {
+                                best = cost;
+                                best_bel = bel;
+                                break;
+                            }
+                            continue;
+                        }
+                        if (!ci->testRegion(bel) || !ctx->checkBelAvail(bel))
+                            continue;
+                        ctx->bindBel(bel, ci, STRENGTH_WEAK);
+                        bool ok = ctx->isBelLocationValid(bel);
+                        ctx->unbindBel(bel);
+                        if (ok) {
+                            best = cost;
+                            best_bel = bel;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        if (best_bel == BelId())
+            return false;
+        if (ci->cluster != ClusterId()) {
+            std::vector<std::pair<CellInfo *, BelId>> targets;
+            NPNR_ASSERT(ctx->getClusterPlacement(ci->cluster, best_bel, targets));
+            for (auto &t : targets) {
+                ctx->bindBel(t.second, t.first, STRENGTH_STRONG);
+                if (t.first->udata != -1) {
+                    auto &tm = mcells.at(t.first->udata);
+                    tm.pos = tm.ref_pos = RealPair(get_place_loc(ctx->getBelLocation(t.second)), 0.5);
+                    tm.is_fixed = true;
+                }
+            }
+            legal_ring_placed++;
+            return true;
+        }
+        ctx->bindBel(best_bel, ci, STRENGTH_WEAK);
+        Loc loc = get_place_loc(ctx->getBelLocation(best_bel));
+        mc.pos = mc.ref_pos = RealPair(loc, 0.5);
+        mc.is_fixed = true;
+        legal_ring_placed++;
+        return true;
+    }
+    int legal_ring_placed = 0;
